# SOOP Downloader - Caddy reverse proxy template
#
# 1) Replace YOUR_DOMAIN.example.com with your DNS hostname.
# 2) Keep soop-server bound to 127.0.0.1:8787 (default).
# 3) Router port forwarding must target THIS PC's LAN IPv4 address:
#      TCP 80  -> <PC-LAN-IP>:80
#      TCP 443 -> <PC-LAN-IP>:443
#    Do NOT forward router traffic to 127.0.0.1 and do NOT expose 8787 directly.
# 4) Allow caddy.exe / TCP 80,443 through Windows Firewall.
# 5) Test from mobile LTE/5G if your router does not support NAT loopback.

YOUR_DOMAIN.example.com {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8787

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
