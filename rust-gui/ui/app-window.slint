import { Button, LineEdit, ScrollView } from "std-widgets.slint";

export struct SettingRow { key: string, value: string, description: string, pickable: bool }
export struct DiagnosticRow { name: string, status: string, detail: string }
export struct LiveChannelRow {
    target: string,
    platform: string,
    name: string,
    account: string,
    status: string,
    status-label: string,
    status-tone: string,
    title: string,
    bno: string,
    file: string,
    size: string,
    started-at: string,
    suppressed: bool,
    detail: string,
    can-stop-once: bool,
    can-resume: bool,
    can-recheck: bool,
    password-required: bool,
}

export global AppState {
    in-out property <[SettingRow]> settings-rows;
    in-out property <[DiagnosticRow]> diagnostics-rows;
    in-out property <bool> settings-busy: true;
    in-out property <bool> settings-loaded: false;
    in-out property <bool> settings-dirty: false;
    in-out property <string> settings-message: "Loading settings...";
    callback setting-edited(int, string);
    callback save-settings();
    callback reload-settings();
    callback pick-setting(int);

    in-out property <[LiveChannelRow]> live-rows;
    in-out property <bool> live-busy: true;
    in-out property <bool> live-loaded: false;
    in-out property <bool> live-running: false;
    in-out property <string> live-state: "Loading";
    in-out property <string> live-engine: "-";
    in-out property <string> live-started-at: "-";
    in-out property <string> live-channel-count: "0";
    in-out property <string> live-recording-count: "0";
    in-out property <string> live-offline-count: "0";
    in-out property <string> live-error-count: "0";
    in-out property <string> live-message: "Loading LIVE runtime...";
    in-out property <string> live-password-target: "";
    in-out property <string> live-password-label: "";
    in-out property <string> live-password-draft: "";
    callback live-start();
    callback live-stop();
    callback live-refresh();
    callback live-action(string, string);
    callback live-password-submit(string, string);

    in-out property <string> active-page: "Dashboard";
    in-out property <bool> runtime-ready: false;
    in-out property <string> runtime-status: "Initializing runtime...";
    in-out property <string> backend-path: "-";
    in-out property <string> database-path: "-";
    in-out property <string> channel-count: "0";
    in-out property <string> tool-summary: "Streamlink -  |  yt-dlp -  |  FFmpeg -";
    callback refresh-requested();
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> page;
    height: 42px;
    border-radius: 8px;
    background: AppState.active-page == root.page ? #334155 : transparent;

    Text {
        x: 14px;
        width: parent.width - 28px;
        height: parent.height;
        text: root.label;
        color: AppState.active-page == root.page ? #f8fafc : #cbd5e1;
        vertical-alignment: center;
        font-size: 15px;
    }

    TouchArea {
        clicked => { AppState.active-page = root.page; }
    }
}

component PlaceholderPage inherits Rectangle {
    in property <string> title;
    in property <string> description;
    background: #ffffff;
    border-radius: 12px;
    border-width: 1px;
    border-color: #e2e8f0;

    VerticalLayout {
        padding: 24px;
        spacing: 12px;
        Text { text: root.title; color: #0f172a; font-size: 22px; font-weight: 700; }
        Text { text: root.description; color: #64748b; font-size: 14px; wrap: word-wrap; }
    }
}

component LiveMetric inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: 76px;
    horizontal-stretch: 1;
    background: #ffffff;
    border-radius: 10px;
    border-width: 1px;
    border-color: #e2e8f0;
    VerticalLayout {
        padding: 12px;
        spacing: 4px;
        Text { text: root.label; color: #64748b; font-size: 11px; }
        Text { text: root.value; color: #0f172a; font-size: 21px; font-weight: 700; }
    }
}

export component MainWindow inherits Window {
    title: "Stream Archive";
    width: 1120px;
    height: 720px;
    background: #f1f5f9;

    HorizontalLayout {
        spacing: 0px;

        Rectangle {
            width: 224px;
            background: #0f172a;
            VerticalLayout {
                padding: 18px;
                spacing: 10px;
                Text { text: "Stream Archive"; color: #f8fafc; font-size: 21px; font-weight: 700; }
                Text { text: "Native Desktop"; color: #94a3b8; font-size: 12px; }
                Rectangle { height: 10px; background: transparent; }
                NavItem { label: "Dashboard"; page: "Dashboard"; }
                NavItem { label: "LIVE"; page: "LIVE"; }
                NavItem { label: "VOD"; page: "VOD"; }
                NavItem { label: "Queue"; page: "Queue"; }
                NavItem { label: "History"; page: "History"; }
                NavItem { label: "Settings"; page: "Settings"; }
                Rectangle { vertical-stretch: 1; background: transparent; }
                Rectangle {
                    height: 78px;
                    border-radius: 8px;
                    background: AppState.runtime-ready ? #132a24 : #3a1f23;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 4px;
                        Text {
                            text: AppState.runtime-ready ? "● Environment OK" : "● Environment needs attention";
                            color: AppState.runtime-ready ? #86efac : #fda4af;
                            font-size: 13px;
                            font-weight: 600;
                        }
                        Text { text: AppState.runtime-status; color: #cbd5e1; font-size: 11px; wrap: word-wrap; }
                    }
                }
            }
        }

        Rectangle {
            background: #f1f5f9;
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        spacing: 3px;
                        horizontal-stretch: 1;
                        Text { text: AppState.active-page; color: #0f172a; font-size: 27px; font-weight: 700; }
                        Text { text: "Phase 21 Slint native shell"; color: #64748b; font-size: 13px; }
                    }
                    Button {
                        text: "Refresh runtime";
                        enabled: !AppState.settings-busy;
                        clicked => { AppState.refresh-requested(); }
                    }
                }

                if AppState.active-page == "Dashboard": Rectangle {
                    background: transparent;
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 14px;
                        Rectangle {
                            height: 112px;
                            background: #ffffff;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: #e2e8f0;
                            VerticalLayout {
                                padding: 20px;
                                spacing: 7px;
                                Text { text: "Runtime"; color: #475569; font-size: 12px; font-weight: 600; }
                                Text { text: AppState.runtime-status; color: #0f172a; font-size: 19px; font-weight: 700; }
                                Text { text: AppState.tool-summary; color: #64748b; font-size: 13px; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 14px;
                            Rectangle {
                                background: #ffffff;
                                border-radius: 12px;
                                border-width: 1px;
                                border-color: #e2e8f0;
                                horizontal-stretch: 1;
                                VerticalLayout {
                                    padding: 20px;
                                    spacing: 7px;
                                    Text { text: "Channels"; color: #64748b; font-size: 12px; }
                                    Text { text: AppState.channel-count; color: #0f172a; font-size: 28px; font-weight: 700; }
                                    Text { text: "Canonical SQLite channel entries"; color: #94a3b8; font-size: 12px; }
                                }
                            }
                            Rectangle {
                                background: #ffffff;
                                border-radius: 12px;
                                border-width: 1px;
                                border-color: #e2e8f0;
                                horizontal-stretch: 2;
                                VerticalLayout {
                                    padding: 20px;
                                    spacing: 7px;
                                    Text { text: "Database"; color: #64748b; font-size: 12px; }
                                    Text { text: AppState.database-path; color: #0f172a; font-size: 13px; wrap: word-wrap; }
                                    Text { text: "Backend: " + AppState.backend-path; color: #94a3b8; font-size: 12px; wrap: word-wrap; }
                                }
                            }
                        }
                    }
                }

                if AppState.active-page == "LIVE": VerticalLayout {
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: "Watcher: " + AppState.live-state;
                            color: AppState.live-running ? #15803d : #475569;
                            font-size: 18px;
                            font-weight: 700;
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: "Start watcher";
                            enabled: AppState.live-loaded && !AppState.live-busy && !AppState.live-running;
                            clicked => { AppState.live-start(); }
                        }
                        Button {
                            text: "Stop watcher";
                            enabled: AppState.live-loaded && !AppState.live-busy && AppState.live-running;
                            clicked => { AppState.live-stop(); }
                        }
                        Button {
                            text: "Refresh";
                            enabled: AppState.live-loaded && !AppState.live-busy;
                            clicked => { AppState.live-refresh(); }
                        }
                    }
                    Text {
                        text: AppState.live-message;
                        color: #334155;
                        wrap: word-wrap;
                        font-size: 12px;
                    }
                    Text {
                        text: "Engine: " + AppState.live-engine + "  ·  Started: " + AppState.live-started-at;
                        color: #64748b;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        LiveMetric { label: "Channels"; value: AppState.live-channel-count; }
                        LiveMetric { label: "Recording"; value: AppState.live-recording-count; }
                        LiveMetric { label: "Offline"; value: AppState.live-offline-count; }
                        LiveMetric { label: "Errors"; value: AppState.live-error-count; }
                    }

                    if AppState.live-password-target != "": Rectangle {
                        height: 112px;
                        background: #fff7ed;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #fdba74;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 6px;
                            Text {
                                text: "Protected broadcast · " + AppState.live-password-label;
                                color: #9a3412;
                                font-weight: 700;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                LineEdit {
                                    text <=> AppState.live-password-draft;
                                    input-type: password;
                                    enabled: !AppState.live-busy;
                                }
                                Button {
                                    text: "Submit password";
                                    enabled: !AppState.live-busy && AppState.live-password-draft != "";
                                    clicked => {
                                        AppState.live-password-submit(AppState.live-password-target, AppState.live-password-draft);
                                    }
                                }
                                Button {
                                    text: "Cancel";
                                    enabled: !AppState.live-busy;
                                    clicked => {
                                        AppState.live-password-target = "";
                                        AppState.live-password-label = "";
                                        AppState.live-password-draft = "";
                                    }
                                }
                            }
                            Text { text: "The stream password is kept in memory only and is not stored in Settings or SQLite."; color: #9a3412; font-size: 11px; }
                        }
                    }

                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding: 2px;
                            spacing: 10px;
                            if AppState.live-rows.length == 0: Rectangle {
                                height: 82px;
                                background: #ffffff;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: #e2e8f0;
                                VerticalLayout {
                                    padding: 16px;
                                    Text { text: "No LIVE channels in the current runtime snapshot."; color: #64748b; }
                                }
                            }
                            for row in AppState.live-rows: Rectangle {
                                min-height: 154px;
                                background: #ffffff;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: row.status-tone == "error" ? #fecaca : row.status-tone == "warn" ? #fde68a : row.status-tone == "ok" ? #bbf7d0 : #e2e8f0;
                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 5px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: row.platform + " · " + (row.name != "" ? row.name : row.account);
                                            color: #0f172a;
                                            font-size: 16px;
                                            font-weight: 700;
                                            horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: row.status-label;
                                            color: row.status-tone == "error" ? #b91c1c : row.status-tone == "warn" ? #a16207 : row.status-tone == "ok" ? #15803d : #64748b;
                                            font-weight: 700;
                                        }
                                    }
                                    Text { text: row.account; color: #64748b; font-size: 11px; }
                                    if row.title != "": Text { text: row.title; color: #334155; wrap: word-wrap; }
                                    if row.bno != "": Text { text: "Broadcast: " + row.bno; color: #64748b; font-size: 11px; }
                                    if row.file != "": Text { text: "File: " + row.file; color: #475569; wrap: word-wrap; font-size: 11px; }
                                    if row.size != "" || row.started-at != "": Text {
                                        text: (row.size != "" ? "Size: " + row.size : "") + (row.started-at != "" ? "  ·  Started: " + row.started-at : "");
                                        color: #64748b;
                                        font-size: 11px;
                                    }
                                    if row.suppressed: Text { text: "Current broadcast is suppressed until the broadcast changes or monitoring is resumed."; color: #a16207; font-size: 11px; wrap: word-wrap; }
                                    if row.detail != "": Text { text: row.detail; color: row.status-tone == "error" ? #b91c1c : #64748b; font-size: 11px; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        if row.can-stop-once: Button {
                                            text: "Stop current broadcast";
                                            enabled: !AppState.live-busy;
                                            clicked => { AppState.live-action(row.target, "stop"); }
                                        }
                                        if row.can-resume: Button {
                                            text: "Resume monitoring";
                                            enabled: !AppState.live-busy;
                                            clicked => { AppState.live-action(row.target, "resume"); }
                                        }
                                        if row.can-recheck: Button {
                                            text: "Recheck";
                                            enabled: !AppState.live-busy;
                                            clicked => { AppState.live-action(row.target, "recheck"); }
                                        }
                                        if row.password-required: Button {
                                            text: "Enter stream password";
                                            enabled: !AppState.live-busy;
                                            clicked => {
                                                AppState.live-password-target = row.target;
                                                AppState.live-password-label = row.platform + " · " + (row.name != "" ? row.name : row.account);
                                                AppState.live-password-draft = "";
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }
                                }
                            }
                        }
                    }
                }

                if AppState.active-page == "VOD": PlaceholderPage {
                    title: "VOD";
                    description: "VOD analysis, quality selection, download progress, retry, and cancellation move here in Phase 21.5.";
                    vertical-stretch: 1;
                }
                if AppState.active-page == "Queue": PlaceholderPage {
                    title: "Queue";
                    description: "Queue state and lifecycle controls move here after reusable queue services are separated from the Axum adapter.";
                    vertical-stretch: 1;
                }
                if AppState.active-page == "History": PlaceholderPage {
                    title: "History";
                    description: "LIVE/VOD history browsing and filtering move here in Phase 21.6.";
                    vertical-stretch: 1;
                }

                if AppState.active-page == "Settings": VerticalLayout {
                    spacing: 10px;
                    Text { text: "Editable settings · shared SQLite"; color: #0f172a; font-size: 18px; font-weight: 700; }
                    Text { text: AppState.settings-message; wrap: word-wrap; color: #334155; }
                    HorizontalLayout {
                        spacing: 10px;
                        Button {
                            text: AppState.settings-dirty ? "Save changes *" : "Save changes";
                            enabled: AppState.settings-loaded && !AppState.settings-busy && AppState.settings-dirty;
                            clicked => { AppState.save-settings(); }
                        }
                        Button {
                            text: "Discard edits / reload saved";
                            enabled: AppState.settings-loaded && !AppState.settings-busy;
                            clicked => { AppState.reload-settings(); }
                        }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding: 4px;
                            spacing: 12px;
                            for row[index] in AppState.settings-rows: VerticalLayout {
                                spacing: 4px;
                                Text { text: row.key; color: #0f172a; font-weight: 600; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit {
                                        text <=> row.value;
                                        enabled: !AppState.settings-busy;
                                        edited(value) => { AppState.setting-edited(index, value); }
                                    }
                                    if row.pickable: Button {
                                        text: "Browse...";
                                        enabled: !AppState.settings-busy;
                                        clicked => { AppState.pick-setting(index); }
                                    }
                                }
                                Text { text: row.description; color: #64748b; wrap: word-wrap; font-size: 12px; }
                            }
                            Text { text: "Diagnostics · read-only"; color: #0f172a; font-size: 18px; font-weight: 700; }
                            Text { text: "Backend and database locations are startup-managed. No separate config file is used."; color: #64748b; wrap: word-wrap; }
                            for row in AppState.diagnostics-rows: VerticalLayout {
                                spacing: 3px;
                                Text {
                                    text: row.status + " · " + row.name;
                                    color: row.status == "OK" ? #15803d : row.status == "Warning" ? #a16207 : #b91c1c;
                                    font-weight: 600;
                                }
                                Text { text: row.detail; color: #334155; wrap: word-wrap; font-size: 12px; }
                            }
                        }
                    }
                }
            }
        }
    }
}
