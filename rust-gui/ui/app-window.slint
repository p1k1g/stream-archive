import { Button, LineEdit, ScrollView } from "std-widgets.slint";

export struct SettingRow { key: string, value: string, description: string, pickable: bool }
export struct DiagnosticRow { name: string, status: string, detail: string }
export struct ChannelConfigRow {
    platform: string,
    enabled: bool,
    name: string,
    account: string,
    outdir: string,
}
export struct LiveChannelRow {
    target: string,
    platform: string,
    name: string,
    account: string,
    status: string,
    status-label: string,
    status-tone: string,
    title: string,
    bno: string,
    file: string,
    size: string,
    started-at: string,
    suppressed: bool,
    detail: string,
    can-stop-once: bool,
    can-resume: bool,
    can-recheck: bool,
    password-required: bool,
}
export struct VodQualityRow {
    value: string,
    label: string,
    selected: bool,
}
export struct VodPartRow {
    part: string,
    duration: string,
    selected: bool,
}

export global AppState {
    in-out property <[SettingRow]> settings-rows;
    in-out property <[DiagnosticRow]> diagnostics-rows;
    in-out property <bool> settings-busy: true;
    in-out property <bool> settings-loaded: false;
    in-out property <bool> settings-dirty: false;
    in-out property <string> settings-message: "Loading settings...";
    callback setting-edited(int, string);
    callback save-settings();
    callback reload-settings();
    callback pick-setting(int);

    in-out property <[ChannelConfigRow]> channel-config-rows;
    in-out property <bool> config-busy: true;
    in-out property <bool> config-loaded: false;
    in-out property <bool> channels-dirty: false;
    in-out property <string> config-message: "Loading channels and provider configuration...";
    callback channel-add();
    callback channel-remove(int);
    callback channel-edited(int, string, string);
    callback channel-toggle-enabled(int);
    callback channel-toggle-platform(int);
    callback channel-resolve(int);
    callback save-channels();
    callback reload-configuration();

    in-out property <string> soop-username: "";
    in-out property <string> cloudflare-worker-url: "";
    in-out property <bool> soop-password-configured: false;
    in-out property <bool> cloudflare-key-configured: false;
    in-out property <bool> chzzk-nid-aut-configured: false;
    in-out property <bool> chzzk-nid-ses-configured: false;
    in-out property <string> soop-password-draft: "";
    in-out property <string> cloudflare-key-draft: "";
    in-out property <string> chzzk-nid-aut-draft: "";
    in-out property <string> chzzk-nid-ses-draft: "";
    callback save-provider();
    callback test-soop-auth();

    in-out property <[LiveChannelRow]> live-rows;
    in-out property <bool> live-busy: true;
    in-out property <bool> live-loaded: false;
    in-out property <bool> live-running: false;
    in-out property <string> live-state: "Loading";
    in-out property <string> live-engine: "-";
    in-out property <string> live-started-at: "-";
    in-out property <string> live-channel-count: "0";
    in-out property <string> live-recording-count: "0";
    in-out property <string> live-offline-count: "0";
    in-out property <string> live-error-count: "0";
    in-out property <string> live-message: "Loading LIVE runtime...";
    in-out property <string> live-password-target: "";
    in-out property <string> live-password-label: "";
    in-out property <string> live-password-draft: "";
    callback live-start();
    callback live-stop();
    callback live-refresh();
    callback live-action(string, string);
    callback live-password-submit(string, string);

    in-out property <[VodQualityRow]> vod-quality-rows;
    in-out property <[VodPartRow]> vod-part-rows;
    in-out property <bool> vod-busy: true;
    in-out property <bool> vod-loaded: false;
    in-out property <bool> vod-running: false;
    in-out property <bool> vod-can-analyze: false;
    in-out property <bool> vod-can-download: false;
    in-out property <bool> vod-merge: true;
    in-out property <string> vod-url: "";
    in-out property <string> vod-output-directory: "";
    in-out property <string> vod-platform: "-";
    in-out property <string> vod-state: "IDLE";
    in-out property <string> vod-state-tone: "neutral";
    in-out property <string> vod-message: "Loading VOD runtime...";
    in-out property <string> vod-runtime-message: "";
    in-out property <string> vod-title: "";
    in-out property <string> vod-streamer: "";
    in-out property <string> vod-streamer-id: "";
    in-out property <string> vod-current-part: "0";
    in-out property <string> vod-part-count: "0";
    in-out property <float> vod-percent: 0;
    in-out property <string> vod-percent-label: "0.0%";
    in-out property <string> vod-output-file: "";
    in-out property <string> vod-started-at: "-";
    in-out property <string> vod-finished-at: "-";
    callback vod-url-edited(string);
    callback vod-output-edited(string);
    callback vod-analyze();
    callback vod-pick-output();
    callback vod-select-quality(int);
    callback vod-toggle-part(int);
    callback vod-select-all-parts();
    callback vod-clear-parts();
    callback vod-toggle-merge();
    callback vod-download();
    callback vod-cancel();
    callback vod-refresh();

    in-out property <string> active-page: "Dashboard";
    in-out property <bool> runtime-ready: false;
    in-out property <string> runtime-status: "Initializing runtime...";
    in-out property <string> backend-path: "-";
    in-out property <string> database-path: "-";
    in-out property <string> channel-count: "0";
    in-out property <string> tool-summary: "Streamlink -  |  yt-dlp -  |  FFmpeg -";
    callback refresh-requested();
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> page;
    height: 42px;
    vertical-stretch: 0;
    border-radius: 8px;
    background: AppState.active-page == root.page ? #334155 : transparent;

    Text {
        x: 14px;
        width: parent.width - 28px;
        height: parent.height;
        text: root.label;
        color: AppState.active-page == root.page ? #f8fafc : #cbd5e1;
        vertical-alignment: center;
        font-size: 15px;
    }

    TouchArea { clicked => { AppState.active-page = root.page; } }
}

component PlaceholderPage inherits Rectangle {
    in property <string> title;
    in property <string> description;
    background: #ffffff;
    border-radius: 12px;
    border-width: 1px;
    border-color: #e2e8f0;

    VerticalLayout {
        padding: 24px;
        spacing: 12px;
        Text { text: root.title; color: #0f172a; font-size: 22px; font-weight: 700; }
        Text { text: root.description; color: #64748b; font-size: 14px; wrap: word-wrap; }
        Rectangle { vertical-stretch: 1; background: transparent; }
    }
}

component LiveMetric inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: 74px;
    vertical-stretch: 0;
    horizontal-stretch: 1;
    background: #ffffff;
    border-radius: 10px;
    border-width: 1px;
    border-color: #e2e8f0;
    VerticalLayout {
        padding: 12px;
        spacing: 4px;
        Text { text: root.label; color: #64748b; font-size: 11px; }
        Text { text: root.value; color: #0f172a; font-size: 21px; font-weight: 700; }
    }
}

export component MainWindow inherits Window {
    title: "Stream Archive";
    preferred-width: 1120px;
    preferred-height: 720px;
    min-width: 1000px;
    min-height: 650px;
    background: #f1f5f9;

    HorizontalLayout {
        spacing: 0px;

        Rectangle {
            width: 224px;
            horizontal-stretch: 0;
            background: #0f172a;
            VerticalLayout {
                padding: 18px;
                spacing: 9px;
                Text { text: "Stream Archive"; color: #f8fafc; font-size: 21px; font-weight: 700; }
                Text { text: "Native Desktop"; color: #94a3b8; font-size: 12px; }
                Rectangle { height: 10px; vertical-stretch: 0; background: transparent; }
                NavItem { label: "Dashboard"; page: "Dashboard"; }
                NavItem { label: "LIVE"; page: "LIVE"; }
                NavItem { label: "Channels"; page: "Channels"; }
                NavItem { label: "VOD"; page: "VOD"; }
                NavItem { label: "Queue"; page: "Queue"; }
                NavItem { label: "History"; page: "History"; }
                NavItem { label: "Settings"; page: "Settings"; }
                Rectangle { vertical-stretch: 1; background: transparent; }
                Rectangle {
                    height: 78px;
                    vertical-stretch: 0;
                    border-radius: 8px;
                    background: AppState.runtime-ready ? #132a24 : #3a1f23;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 4px;
                        Text {
                            text: AppState.runtime-ready ? "● Environment OK" : "● Environment needs attention";
                            color: AppState.runtime-ready ? #86efac : #fda4af;
                            font-size: 13px;
                            font-weight: 600;
                        }
                        Text { text: AppState.runtime-status; color: #cbd5e1; font-size: 11px; wrap: word-wrap; }
                    }
                }
            }
        }

        Rectangle {
            background: #f1f5f9;
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 24px;
                spacing: 14px;

                HorizontalLayout {
                    height: 54px;
                    vertical-stretch: 0;
                    spacing: 12px;
                    VerticalLayout {
                        spacing: 3px;
                        horizontal-stretch: 1;
                        Text { text: AppState.active-page; color: #0f172a; font-size: 27px; font-weight: 700; }
                        Text { text: "Phase 21 Slint native shell"; color: #64748b; font-size: 13px; }
                    }
                    Button {
                        height: 36px;
                        vertical-stretch: 0;
                        text: "Refresh runtime";
                        enabled: !AppState.settings-busy;
                        clicked => { AppState.refresh-requested(); }
                    }
                }

                if AppState.active-page == "Dashboard": Rectangle {
                    background: transparent;
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 14px;
                        Rectangle {
                            height: 112px;
                            vertical-stretch: 0;
                            background: #ffffff;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: #e2e8f0;
                            VerticalLayout {
                                padding: 20px;
                                spacing: 7px;
                                Text { text: "Runtime"; color: #475569; font-size: 12px; font-weight: 600; }
                                Text { text: AppState.runtime-status; color: #0f172a; font-size: 19px; font-weight: 700; }
                                Text { text: AppState.tool-summary; color: #64748b; font-size: 13px; }
                            }
                        }
                        HorizontalLayout {
                            height: 188px;
                            vertical-stretch: 0;
                            spacing: 14px;
                            Rectangle {
                                background: #ffffff;
                                border-radius: 12px;
                                border-width: 1px;
                                border-color: #e2e8f0;
                                horizontal-stretch: 1;
                                VerticalLayout {
                                    padding: 20px;
                                    spacing: 7px;
                                    Text { text: "Channels"; color: #64748b; font-size: 12px; }
                                    Text { text: AppState.channel-count; color: #0f172a; font-size: 28px; font-weight: 700; }
                                    Text { text: "Canonical SQLite channel entries"; color: #94a3b8; font-size: 12px; }
                                }
                            }
                            Rectangle {
                                background: #ffffff;
                                border-radius: 12px;
                                border-width: 1px;
                                border-color: #e2e8f0;
                                horizontal-stretch: 2;
                                VerticalLayout {
                                    padding: 20px;
                                    spacing: 7px;
                                    Text { text: "Database"; color: #64748b; font-size: 12px; }
                                    Text { text: AppState.database-path; color: #0f172a; font-size: 13px; wrap: word-wrap; }
                                    Text { text: "Backend: " + AppState.backend-path; color: #94a3b8; font-size: 12px; wrap: word-wrap; }
                                }
                            }
                        }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                    }
                }

                if AppState.active-page == "LIVE": VerticalLayout {
                    spacing: 9px;
                    HorizontalLayout {
                        height: 36px;
                        vertical-stretch: 0;
                        spacing: 8px;
                        Text {
                            text: "Watcher: " + AppState.live-state;
                            color: AppState.live-running ? #15803d : #475569;
                            font-size: 18px;
                            font-weight: 700;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Button {
                            height: 34px;
                            text: "Start watcher";
                            enabled: AppState.live-loaded && !AppState.live-busy && !AppState.live-running;
                            clicked => { AppState.live-start(); }
                        }
                        Button {
                            height: 34px;
                            text: "Stop watcher";
                            enabled: AppState.live-loaded && !AppState.live-busy && AppState.live-running;
                            clicked => { AppState.live-stop(); }
                        }
                        Button {
                            height: 34px;
                            text: "Refresh";
                            enabled: AppState.live-loaded && !AppState.live-busy;
                            clicked => { AppState.live-refresh(); }
                        }
                    }
                    Text { text: AppState.live-message; color: #334155; wrap: word-wrap; font-size: 12px; }
                    Text {
                        text: "Engine: " + AppState.live-engine + "  ·  Started: " + AppState.live-started-at;
                        color: #64748b;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        height: 74px;
                        vertical-stretch: 0;
                        spacing: 8px;
                        LiveMetric { label: "Channels"; value: AppState.live-channel-count; }
                        LiveMetric { label: "Recording"; value: AppState.live-recording-count; }
                        LiveMetric { label: "Offline"; value: AppState.live-offline-count; }
                        LiveMetric { label: "Errors"; value: AppState.live-error-count; }
                    }

                    if AppState.live-password-target != "": Rectangle {
                        height: 108px;
                        vertical-stretch: 0;
                        background: #fff7ed;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #fdba74;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 6px;
                            Text { text: "Protected broadcast · " + AppState.live-password-label; color: #9a3412; font-weight: 700; }
                            HorizontalLayout {
                                height: 34px;
                                vertical-stretch: 0;
                                spacing: 8px;
                                LineEdit {
                                    height: 34px;
                                    text <=> AppState.live-password-draft;
                                    input-type: password;
                                    enabled: !AppState.live-busy;
                                }
                                Button {
                                    height: 34px;
                                    text: "Submit password";
                                    enabled: !AppState.live-busy && AppState.live-password-draft != "";
                                    clicked => { AppState.live-password-submit(AppState.live-password-target, AppState.live-password-draft); }
                                }
                                Button {
                                    height: 34px;
                                    text: "Cancel";
                                    enabled: !AppState.live-busy;
                                    clicked => {
                                        AppState.live-password-target = "";
                                        AppState.live-password-label = "";
                                        AppState.live-password-draft = "";
                                    }
                                }
                            }
                            Text { text: "Password is memory-only and is never stored in Settings or SQLite."; color: #9a3412; font-size: 11px; }
                        }
                    }

                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding: 2px;
                            spacing: 10px;
                            if AppState.live-rows.length == 0: Rectangle {
                                height: 82px;
                                vertical-stretch: 0;
                                background: #ffffff;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: #e2e8f0;
                                VerticalLayout {
                                    padding: 16px;
                                    Text { text: "No LIVE channels in the current runtime snapshot. Add channels on the Channels page."; color: #64748b; }
                                }
                            }
                            for row in AppState.live-rows: Rectangle {
                                min-height: 156px;
                                vertical-stretch: 0;
                                background: #ffffff;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: row.status-tone == "error" ? #fecaca : row.status-tone == "warn" ? #fde68a : row.status-tone == "ok" ? #bbf7d0 : #e2e8f0;
                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 5px;
                                    HorizontalLayout {
                                        height: 24px;
                                        vertical-stretch: 0;
                                        spacing: 8px;
                                        Text {
                                            text: row.platform + " · " + (row.name != "" ? row.name : row.account);
                                            color: #0f172a;
                                            font-size: 16px;
                                            font-weight: 700;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: row.status-label;
                                            color: row.status-tone == "error" ? #b91c1c : row.status-tone == "warn" ? #a16207 : row.status-tone == "ok" ? #15803d : #64748b;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Text { text: row.account; color: #64748b; font-size: 11px; }
                                    if row.title != "": Text { text: row.title; color: #334155; wrap: word-wrap; }
                                    if row.bno != "": Text { text: "Broadcast: " + row.bno; color: #64748b; font-size: 11px; }
                                    if row.file != "": Text { text: "File: " + row.file; color: #475569; wrap: word-wrap; font-size: 11px; }
                                    if row.size != "" || row.started-at != "": Text {
                                        text: (row.size != "" ? "Size: " + row.size : "") + (row.started-at != "" ? "  ·  Started: " + row.started-at : "");
                                        color: #64748b;
                                        font-size: 11px;
                                    }
                                    if row.suppressed: Text { text: "Current broadcast is suppressed until the broadcast changes or monitoring is resumed."; color: #a16207; font-size: 11px; wrap: word-wrap; }
                                    if row.detail != "": Text { text: row.detail; color: row.status-tone == "error" ? #b91c1c : #64748b; font-size: 11px; wrap: word-wrap; }
                                    HorizontalLayout {
                                        height: 34px;
                                        vertical-stretch: 0;
                                        spacing: 8px;
                                        if row.can-stop-once: Button {
                                            height: 32px;
                                            text: "Stop current broadcast";
                                            enabled: !AppState.live-busy;
                                            clicked => { AppState.live-action(row.target, "stop"); }
                                        }
                                        if row.can-resume: Button {
                                            height: 32px;
                                            text: "Resume monitoring";
                                            enabled: !AppState.live-busy;
                                            clicked => { AppState.live-action(row.target, "resume"); }
                                        }
                                        if row.can-recheck: Button {
                                            height: 32px;
                                            text: "Recheck";
                                            enabled: !AppState.live-busy;
                                            clicked => { AppState.live-action(row.target, "recheck"); }
                                        }
                                        if row.password-required: Button {
                                            height: 32px;
                                            text: "Enter stream password";
                                            enabled: !AppState.live-busy;
                                            clicked => {
                                                AppState.live-password-target = row.target;
                                                AppState.live-password-label = row.platform + " · " + (row.name != "" ? row.name : row.account);
                                                AppState.live-password-draft = "";
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }
                                }
                            }
                        }
                    }
                }

                if AppState.active-page == "Channels": VerticalLayout {
                    spacing: 9px;
                    HorizontalLayout {
                        height: 36px;
                        vertical-stretch: 0;
                        spacing: 8px;
                        Text {
                            text: "LIVE channel configuration";
                            color: #0f172a;
                            font-size: 18px;
                            font-weight: 700;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Button {
                            height: 34px;
                            text: "+ Add channel";
                            enabled: AppState.config-loaded && !AppState.config-busy;
                            clicked => { AppState.channel-add(); }
                        }
                        Button {
                            height: 34px;
                            text: AppState.channels-dirty ? "Save channels *" : "Save channels";
                            enabled: AppState.config-loaded && !AppState.config-busy && AppState.channels-dirty;
                            clicked => { AppState.save-channels(); }
                        }
                        Button {
                            height: 34px;
                            text: "Reload saved";
                            enabled: AppState.config-loaded && !AppState.config-busy;
                            clicked => { AppState.reload-configuration(); }
                        }
                    }
                    Rectangle {
                        min-height: 58px;
                        vertical-stretch: 0;
                        background: #ffffff;
                        border-radius: 9px;
                        border-width: 1px;
                        border-color: #e2e8f0;
                        VerticalLayout {
                            padding: 11px;
                            spacing: 3px;
                            Text { text: AppState.config-message; color: #334155; wrap: word-wrap; font-size: 12px; }
                            Text {
                                text: "SOOP uses its account id. CHZZK uses the canonical channel id. Resolve fills the display name from the provider.";
                                color: #64748b;
                                wrap: word-wrap;
                                font-size: 11px;
                            }
                        }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding: 2px;
                            spacing: 10px;
                            if AppState.channel-config-rows.length == 0: Rectangle {
                                height: 88px;
                                vertical-stretch: 0;
                                background: #ffffff;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: #e2e8f0;
                                VerticalLayout {
                                    padding: 16px;
                                    Text { text: "No channels configured. Add a channel to create the first canonical SQLite entry."; color: #64748b; wrap: word-wrap; }
                                }
                            }
                            for row[index] in AppState.channel-config-rows: Rectangle {
                                min-height: 188px;
                                vertical-stretch: 0;
                                background: #ffffff;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: #e2e8f0;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 8px;
                                    HorizontalLayout {
                                        height: 34px;
                                        vertical-stretch: 0;
                                        spacing: 8px;
                                        Button {
                                            width: 74px;
                                            height: 32px;
                                            text: row.platform;
                                            enabled: !AppState.config-busy;
                                            clicked => { AppState.channel-toggle-platform(index); }
                                        }
                                        Button {
                                            width: 84px;
                                            height: 32px;
                                            text: row.enabled ? "Enabled" : "Disabled";
                                            enabled: !AppState.config-busy;
                                            clicked => { AppState.channel-toggle-enabled(index); }
                                        }
                                        Text {
                                            text: row.name != "" ? row.name : (row.account != "" ? row.account : "New channel");
                                            color: #0f172a;
                                            font-size: 15px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        Button {
                                            width: 74px;
                                            height: 32px;
                                            text: "Remove";
                                            enabled: !AppState.config-busy;
                                            clicked => { AppState.channel-remove(index); }
                                        }
                                    }
                                    HorizontalLayout {
                                        height: 58px;
                                        vertical-stretch: 0;
                                        spacing: 10px;
                                        VerticalLayout {
                                            spacing: 4px;
                                            horizontal-stretch: 1;
                                            Text { text: "Name"; color: #64748b; font-size: 11px; }
                                            LineEdit {
                                                height: 34px;
                                                vertical-stretch: 0;
                                                text <=> row.name;
                                                enabled: !AppState.config-busy;
                                                edited(value) => { AppState.channel-edited(index, "name", value); }
                                            }
                                        }
                                        VerticalLayout {
                                            spacing: 4px;
                                            horizontal-stretch: 1;
                                            Text { text: "Account / channel id"; color: #64748b; font-size: 11px; }
                                            HorizontalLayout {
                                                height: 34px;
                                                vertical-stretch: 0;
                                                spacing: 6px;
                                                LineEdit {
                                                    height: 34px;
                                                    vertical-stretch: 0;
                                                    text <=> row.account;
                                                    enabled: !AppState.config-busy;
                                                    edited(value) => { AppState.channel-edited(index, "account", value); }
                                                    accepted => { AppState.channel-resolve(index); }
                                                }
                                                Button {
                                                    width: 76px;
                                                    height: 32px;
                                                    text: "Resolve";
                                                    enabled: !AppState.config-busy && row.account != "";
                                                    clicked => { AppState.channel-resolve(index); }
                                                }
                                            }
                                        }
                                    }
                                    VerticalLayout {
                                        height: 56px;
                                        vertical-stretch: 0;
                                        spacing: 4px;
                                        Text { text: "Output directory  ·  blank uses the runtime default"; color: #64748b; font-size: 11px; }
                                        LineEdit {
                                            height: 34px;
                                            vertical-stretch: 0;
                                            text <=> row.outdir;
                                            enabled: !AppState.config-busy;
                                            edited(value) => { AppState.channel-edited(index, "outdir", value); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if AppState.active-page == "VOD": ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 2px;
                        spacing: 10px;

                        Rectangle {
                            min-height: 116px;
                            vertical-stretch: 0;
                            background: #ffffff;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #e2e8f0;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 7px;
                                Text { text: "Analyze a SOOP or CHZZK VOD"; color: #0f172a; font-size: 17px; font-weight: 700; }
                                HorizontalLayout {
                                    height: 34px;
                                    vertical-stretch: 0;
                                    spacing: 8px;
                                    LineEdit {
                                        height: 34px;
                                        text <=> AppState.vod-url;
                                        enabled: !AppState.vod-busy && !AppState.vod-running;
                                        placeholder-text: "https://vod.sooplive.com/player/...  or  https://chzzk.naver.com/video/...";
                                        edited(value) => { AppState.vod-url-edited(value); }
                                        accepted => { AppState.vod-analyze(); }
                                    }
                                    Button {
                                        height: 32px;
                                        text: "Analyze";
                                        enabled: AppState.vod-loaded && AppState.vod-can-analyze && !AppState.vod-busy && !AppState.vod-running;
                                        clicked => { AppState.vod-analyze(); }
                                    }
                                    Button {
                                        height: 32px;
                                        text: "Refresh";
                                        enabled: AppState.vod-loaded && !AppState.vod-busy;
                                        clicked => { AppState.vod-refresh(); }
                                    }
                                    Button {
                                        height: 32px;
                                        text: "Cancel";
                                        enabled: AppState.vod-loaded && AppState.vod-running && !AppState.vod-busy;
                                        clicked => { AppState.vod-cancel(); }
                                    }
                                }
                                Text { text: AppState.vod-message; color: #334155; font-size: 12px; wrap: word-wrap; }
                            }
                        }

                        Rectangle {
                            min-height: 128px;
                            vertical-stretch: 0;
                            background: #ffffff;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: AppState.vod-state-tone == "error" ? #fecaca : AppState.vod-state-tone == "warn" ? #fde68a : AppState.vod-state-tone == "ok" ? #bbf7d0 : #e2e8f0;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 6px;
                                HorizontalLayout {
                                    height: 26px;
                                    vertical-stretch: 0;
                                    spacing: 8px;
                                    Text {
                                        text: AppState.vod-platform + " · " + AppState.vod-state;
                                        color: AppState.vod-state-tone == "error" ? #b91c1c : AppState.vod-state-tone == "warn" ? #a16207 : AppState.vod-state-tone == "ok" ? #15803d : #334155;
                                        font-size: 16px;
                                        font-weight: 700;
                                        horizontal-stretch: 1;
                                    }
                                    Text { text: AppState.vod-current-part + " / " + AppState.vod-part-count + " parts"; color: #64748b; font-size: 12px; }
                                    Text { text: AppState.vod-percent-label; color: #0f172a; font-weight: 700; }
                                }
                                Rectangle {
                                    height: 10px;
                                    vertical-stretch: 0;
                                    background: #e2e8f0;
                                    border-radius: 5px;
                                    Rectangle {
                                        x: 0px;
                                        y: 0px;
                                        height: parent.height;
                                        width: parent.width * AppState.vod-percent / 100;
                                        background: #334155;
                                        border-radius: 5px;
                                    }
                                }
                                Text { text: AppState.vod-runtime-message; color: #475569; font-size: 12px; wrap: word-wrap; }
                                Text {
                                    text: "Started: " + AppState.vod-started-at + "  ·  Finished: " + AppState.vod-finished-at;
                                    color: #94a3b8;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                                if AppState.vod-output-file != "": Text { text: "Output: " + AppState.vod-output-file; color: #475569; font-size: 11px; wrap: word-wrap; }
                            }
                        }

                        if AppState.vod-title != "" || AppState.vod-streamer != "": Rectangle {
                            min-height: 96px;
                            vertical-stretch: 0;
                            background: #ffffff;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #e2e8f0;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 5px;
                                Text { text: AppState.vod-title != "" ? AppState.vod-title : "VOD metadata"; color: #0f172a; font-size: 16px; font-weight: 700; wrap: word-wrap; }
                                Text { text: "Streamer: " + AppState.vod-streamer + (AppState.vod-streamer-id != "" ? "  ·  " + AppState.vod-streamer-id : ""); color: #64748b; font-size: 12px; wrap: word-wrap; }
                                Text { text: "Parts: " + AppState.vod-part-count; color: #64748b; font-size: 12px; }
                            }
                        }

                        HorizontalLayout {
                            min-height: 174px;
                            vertical-stretch: 0;
                            spacing: 10px;
                            Rectangle {
                                horizontal-stretch: 1;
                                background: #ffffff;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: #e2e8f0;
                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 6px;
                                    Text { text: "Quality"; color: #0f172a; font-size: 14px; font-weight: 700; }
                                    ScrollView {
                                        vertical-stretch: 1;
                                        VerticalLayout {
                                            spacing: 5px;
                                            if AppState.vod-quality-rows.length == 0: Text { text: "Analyze a VOD to load qualities."; color: #94a3b8; font-size: 11px; wrap: word-wrap; }
                                            for row[index] in AppState.vod-quality-rows: Button {
                                                height: 30px;
                                                text: (row.selected ? "✓ " : "") + row.label;
                                                enabled: !AppState.vod-busy && !AppState.vod-running;
                                                clicked => { AppState.vod-select-quality(index); }
                                            }
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                background: #ffffff;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: #e2e8f0;
                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 6px;
                                    HorizontalLayout {
                                        height: 30px;
                                        vertical-stretch: 0;
                                        spacing: 6px;
                                        Text { text: "Parts"; color: #0f172a; font-size: 14px; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
                                        Button {
                                            height: 28px;
                                            text: "All";
                                            enabled: AppState.vod-part-rows.length > 0 && !AppState.vod-busy && !AppState.vod-running;
                                            clicked => { AppState.vod-select-all-parts(); }
                                        }
                                        Button {
                                            height: 28px;
                                            text: "Clear";
                                            enabled: AppState.vod-part-rows.length > 0 && !AppState.vod-busy && !AppState.vod-running;
                                            clicked => { AppState.vod-clear-parts(); }
                                        }
                                    }
                                    ScrollView {
                                        vertical-stretch: 1;
                                        VerticalLayout {
                                            spacing: 5px;
                                            if AppState.vod-part-rows.length == 0: Text { text: "Analyze a VOD to load parts."; color: #94a3b8; font-size: 11px; wrap: word-wrap; }
                                            for row[index] in AppState.vod-part-rows: Button {
                                                height: 30px;
                                                text: (row.selected ? "✓ " : "") + "Part " + row.part + "  ·  " + row.duration;
                                                enabled: !AppState.vod-busy && !AppState.vod-running;
                                                clicked => { AppState.vod-toggle-part(index); }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            min-height: 112px;
                            vertical-stretch: 0;
                            background: #ffffff;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #e2e8f0;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 7px;
                                Text { text: "Download"; color: #0f172a; font-size: 16px; font-weight: 700; }
                                HorizontalLayout {
                                    height: 34px;
                                    vertical-stretch: 0;
                                    spacing: 8px;
                                    LineEdit {
                                        height: 34px;
                                        text <=> AppState.vod-output-directory;
                                        enabled: !AppState.vod-busy && !AppState.vod-running;
                                        placeholder-text: "Output directory";
                                        edited(value) => { AppState.vod-output-edited(value); }
                                    }
                                    Button {
                                        height: 32px;
                                        text: "Browse...";
                                        enabled: !AppState.vod-busy && !AppState.vod-running;
                                        clicked => { AppState.vod-pick-output(); }
                                    }
                                    Button {
                                        height: 32px;
                                        text: AppState.vod-merge ? "Merge: On" : "Merge: Off";
                                        enabled: !AppState.vod-busy && !AppState.vod-running;
                                        clicked => { AppState.vod-toggle-merge(); }
                                    }
                                    Button {
                                        height: 32px;
                                        text: "Download";
                                        enabled: AppState.vod-loaded && AppState.vod-can-download && !AppState.vod-busy && !AppState.vod-running;
                                        clicked => { AppState.vod-download(); }
                                    }
                                }
                                Text { text: "Tool paths and provider authentication come from canonical Settings; the Native UI does not spawn media tools directly."; color: #64748b; font-size: 11px; wrap: word-wrap; }
                            }
                        }
                    }
                }
                if AppState.active-page == "Queue": PlaceholderPage {
                    title: "Queue";
                    description: "Queue state and lifecycle controls move here after reusable queue services are separated from the Axum adapter.";
                    vertical-stretch: 1;
                }
                if AppState.active-page == "History": PlaceholderPage {
                    title: "History";
                    description: "LIVE/VOD history browsing and filtering move here in Phase 21.6.";
                    vertical-stretch: 1;
                }

                if AppState.active-page == "Settings": VerticalLayout {
                    spacing: 9px;
                    Text { text: "Editable settings · shared SQLite"; color: #0f172a; font-size: 18px; font-weight: 700; }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding: 3px;
                            spacing: 12px;

                            Rectangle {
                                min-height: 330px;
                                vertical-stretch: 0;
                                background: #ffffff;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: #e2e8f0;
                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 8px;
                                    Text { text: "Provider credentials"; color: #0f172a; font-size: 18px; font-weight: 700; }
                                    Text { text: AppState.config-message; color: #334155; wrap: word-wrap; font-size: 12px; }
                                    HorizontalLayout {
                                        height: 34px;
                                        vertical-stretch: 0;
                                        spacing: 8px;
                                        Button {
                                            height: 32px;
                                            text: "Save provider configuration";
                                            enabled: AppState.config-loaded && !AppState.config-busy;
                                            clicked => { AppState.save-provider(); }
                                        }
                                        Button {
                                            height: 32px;
                                            text: "Test SOOP + Worker";
                                            enabled: AppState.config-loaded && !AppState.config-busy
                                                && AppState.soop-username != ""
                                                && AppState.cloudflare-worker-url != ""
                                                && AppState.soop-password-configured
                                                && AppState.cloudflare-key-configured;
                                            clicked => { AppState.test-soop-auth(); }
                                        }
                                        Button {
                                            height: 32px;
                                            text: "Reload saved";
                                            enabled: AppState.config-loaded && !AppState.config-busy;
                                            clicked => { AppState.reload-configuration(); }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }
                                    HorizontalLayout {
                                        height: 58px;
                                        vertical-stretch: 0;
                                        spacing: 10px;
                                        VerticalLayout {
                                            spacing: 4px;
                                            Text { text: "SOOP username"; color: #0f172a; font-weight: 600; font-size: 12px; }
                                            LineEdit { height: 34px; text <=> AppState.soop-username; enabled: !AppState.config-busy; }
                                        }
                                        VerticalLayout {
                                            spacing: 4px;
                                            Text { text: "Cloudflare Worker URL"; color: #0f172a; font-weight: 600; font-size: 12px; }
                                            LineEdit { height: 34px; text <=> AppState.cloudflare-worker-url; enabled: !AppState.config-busy; }
                                        }
                                    }
                                    HorizontalLayout {
                                        height: 58px;
                                        vertical-stretch: 0;
                                        spacing: 10px;
                                        VerticalLayout {
                                            spacing: 4px;
                                            Text { text: "SOOP password · " + (AppState.soop-password-configured ? "Configured" : "Not configured"); color: AppState.soop-password-configured ? #15803d : #a16207; font-size: 11px; }
                                            LineEdit { height: 34px; text <=> AppState.soop-password-draft; input-type: password; enabled: !AppState.config-busy; }
                                        }
                                        VerticalLayout {
                                            spacing: 4px;
                                            Text { text: "Worker API key · " + (AppState.cloudflare-key-configured ? "Configured" : "Not configured"); color: AppState.cloudflare-key-configured ? #15803d : #a16207; font-size: 11px; }
                                            LineEdit { height: 34px; text <=> AppState.cloudflare-key-draft; input-type: password; enabled: !AppState.config-busy; }
                                        }
                                    }
                                    HorizontalLayout {
                                        height: 58px;
                                        vertical-stretch: 0;
                                        spacing: 10px;
                                        VerticalLayout {
                                            spacing: 4px;
                                            Text { text: "CHZZK NID_AUT · " + (AppState.chzzk-nid-aut-configured ? "Configured" : "Not configured"); color: AppState.chzzk-nid-aut-configured ? #15803d : #a16207; font-size: 11px; }
                                            LineEdit { height: 34px; text <=> AppState.chzzk-nid-aut-draft; input-type: password; enabled: !AppState.config-busy; }
                                        }
                                        VerticalLayout {
                                            spacing: 4px;
                                            Text { text: "CHZZK NID_SES · " + (AppState.chzzk-nid-ses-configured ? "Configured" : "Not configured"); color: AppState.chzzk-nid-ses-configured ? #15803d : #a16207; font-size: 11px; }
                                            LineEdit { height: 34px; text <=> AppState.chzzk-nid-ses-draft; input-type: password; enabled: !AppState.config-busy; }
                                        }
                                    }
                                    Text {
                                        text: "Blank secret fields keep the saved value. Secrets remain protected by the platform secret store and are never read back into the UI.";
                                        color: #64748b;
                                        wrap: word-wrap;
                                        font-size: 11px;
                                    }
                                }
                            }

                            Rectangle {
                                min-height: 72px;
                                vertical-stretch: 0;
                                background: #ffffff;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: #e2e8f0;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 6px;
                                    HorizontalLayout {
                                        height: 32px;
                                        vertical-stretch: 0;
                                        spacing: 8px;
                                        Text { text: "Runtime environment"; color: #0f172a; font-size: 17px; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
                                        Button {
                                            height: 30px;
                                            text: AppState.settings-dirty ? "Save changes *" : "Save changes";
                                            enabled: AppState.settings-loaded && !AppState.settings-busy && AppState.settings-dirty;
                                            clicked => { AppState.save-settings(); }
                                        }
                                        Button {
                                            height: 30px;
                                            text: "Reload saved";
                                            enabled: AppState.settings-loaded && !AppState.settings-busy;
                                            clicked => { AppState.reload-settings(); }
                                        }
                                    }
                                    Text { text: AppState.settings-message; wrap: word-wrap; color: #64748b; font-size: 11px; }
                                }
                            }

                            for row[index] in AppState.settings-rows: Rectangle {
                                min-height: 82px;
                                vertical-stretch: 0;
                                background: #ffffff;
                                border-radius: 9px;
                                border-width: 1px;
                                border-color: #e2e8f0;
                                VerticalLayout {
                                    padding: 11px;
                                    spacing: 5px;
                                    Text { text: row.key; color: #0f172a; font-weight: 600; font-size: 12px; }
                                    HorizontalLayout {
                                        height: 34px;
                                        vertical-stretch: 0;
                                        spacing: 8px;
                                        LineEdit {
                                            height: 34px;
                                            text <=> row.value;
                                            enabled: !AppState.settings-busy;
                                            edited(value) => { AppState.setting-edited(index, value); }
                                        }
                                        if row.pickable: Button {
                                            width: 78px;
                                            height: 32px;
                                            text: "Browse...";
                                            enabled: !AppState.settings-busy;
                                            clicked => { AppState.pick-setting(index); }
                                        }
                                    }
                                    Text { text: row.description; color: #64748b; wrap: word-wrap; font-size: 11px; }
                                }
                            }

                            Text { text: "Diagnostics · read-only"; color: #0f172a; font-size: 18px; font-weight: 700; }
                            Text { text: "Backend and database locations are startup-managed. No separate config file is used."; color: #64748b; wrap: word-wrap; font-size: 11px; }
                            for row in AppState.diagnostics-rows: Rectangle {
                                min-height: 56px;
                                vertical-stretch: 0;
                                background: #ffffff;
                                border-radius: 9px;
                                border-width: 1px;
                                border-color: #e2e8f0;
                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 3px;
                                    Text {
                                        text: row.status + " · " + row.name;
                                        color: row.status == "OK" ? #15803d : row.status == "Warning" ? #a16207 : #b91c1c;
                                        font-weight: 600;
                                        font-size: 12px;
                                    }
                                    Text { text: row.detail; color: #475569; wrap: word-wrap; font-size: 11px; }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
