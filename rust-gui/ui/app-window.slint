import { Theme, ActionButton as Button, StatusPill, PlatformBadge } from "design-system.slint";
import { ComboBox, LineEdit, ScrollView, Palette, CheckBox } from "std-widgets.slint";
import { QueuePage, HistoryPage, QueueHistoryState as QueueHistoryLocal } from "queue-history.slint";
import { MaintenancePage, MaintenanceState } from "maintenance.slint";
export { QueueHistoryState } from "queue-history.slint";
export { MaintenanceState, MaintenanceBackupRow, MaintenanceDiagnosticRow, MaintenanceLogRow } from "maintenance.slint";

export struct SettingRow { key: string, value: string, description: string, pickable: bool }
export struct DiagnosticRow { name: string, status: string, detail: string }
export struct ChannelConfigRow {
    platform: string,
    enabled: bool,
    name: string,
    account: string,
    outdir: string,
}
export struct LiveChannelRow {
    target: string,
    platform: string,
    name: string,
    account: string,
    status: string,
    status-label: string,
    status-tone: string,
    title: string,
    bno: string,
    file: string,
    size: string,
    started-at: string,
    suppressed: bool,
    detail: string,
    can-stop-once: bool,
    can-resume: bool,
    can-recheck: bool,
    password-required: bool,
}
export struct StorageDisplayRow {
    volume: string,
    roles: string,
    paths: string,
    capacity: string,
    used: string,
    status: string,
    status-tone: string,
    detail: string,
}
export struct VodQualityRow {
    value: string,
    label: string,
    selected: bool,
}
export struct VodPartRow {
    part: string,
    duration: string,
    selected: bool,
}

component LiveActions inherits HorizontalLayout {
    in property <LiveChannelRow> channel;
    spacing: 8px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    alignment: center;
    StatusPill { text: root.channel.status-label; tone: root.channel.status-tone; dot: true; boxed: true; }
    Rectangle { width: 1px; height: 24px; background: Theme.border; vertical-stretch: 0; }
    if root.channel.can-stop-once: Button {
        height: 34px;
        text: "저장 폴더 열기"; icon: @image-url("../assets/actions/folder.svg");
        enabled: !AppState.live-busy && root.channel.file != "";
        clicked => { AppState.live-open-folder(root.channel.file); }
    }
    if root.channel.can-stop-once: Button {
        height: 34px;
        text: "현재 방송 녹화 중지"; icon: @image-url("../assets/actions/stop.svg"); danger: true;
        enabled: !AppState.live-busy;
        clicked => { AppState.live-action(root.channel.target, "stop"); }
    }
    if root.channel.can-resume: Button {
        height: 34px;
        text: "모니터링 재개"; icon: @image-url("../assets/actions/play.svg");
        enabled: !AppState.live-busy;
        clicked => { AppState.live-action(root.channel.target, "resume"); }
    }
    if root.channel.can-recheck: Button {
        height: 34px;
        text: "다시 확인"; icon: @image-url("../assets/actions/refresh.svg");
        enabled: !AppState.live-busy;
        clicked => { AppState.live-action(root.channel.target, "recheck"); }
    }
    if root.channel.password-required: Button {
        height: 34px;
        text: "방송 비밀번호 입력";
        enabled: !AppState.live-busy;
        clicked => {
            AppState.live-password-target = root.channel.target;
            AppState.live-password-label = root.channel.platform + " · " + (root.channel.name != "" ? root.channel.name : root.channel.account);
            AppState.live-password-draft = "";
        }
    }
}

export global AppState {
    in-out property <[SettingRow]> settings-rows;
    in-out property <bool> close-to-tray: false;
    in-out property <string> close-action: "EXIT";
    in-out property <bool> close-dialog-visible: false;
    in-out property <bool> close-remember: false;
    in-out property <bool> close-choice-busy: false;
    in-out property <string> close-choice-error: "";
    callback close-choice(string, bool);
    callback close-apply(string);
    in-out property <bool> desktop-exit-pending: false;
    in-out property <bool> desktop-poll-pending: false;
    in-out property <string> desktop-status: "상태 확인 중";
    callback desktop-exit();
    callback desktop-poll();
    in-out property <bool> download-notifications-enabled: true;
    in-out property <string> download-notifications-status: "";
    callback download-notice(int, int);
    callback clear-download-notices();
    in-out property <[DiagnosticRow]> diagnostics-rows;
    in-out property <bool> settings-busy: true;
    in-out property <bool> settings-loaded: false;
    in-out property <bool> settings-dirty: false;
    in-out property <string> settings-message: "설정을 불러오는 중...";
    callback setting-edited(int, string);
    callback save-settings();
    callback reload-settings();
    callback pick-setting(int);

    in-out property <[ChannelConfigRow]> channel-config-rows;
    in-out property <bool> config-busy: true;
    in-out property <bool> config-loaded: false;
    in-out property <bool> channels-dirty: false;
    in-out property <string> config-message: "채널 및 공급자 설정을 불러오는 중...";
    callback channel-add();
    callback channel-remove(int);
    callback channel-edited(int, string, string);
    callback channel-toggle-enabled(int);
    callback channel-select-platform(int, string);
    callback channel-resolve(int);
    callback save-channels();
    callback reload-configuration();

    in-out property <string> soop-username: "";
    in-out property <string> cloudflare-worker-url: "";
    in-out property <bool> soop-password-configured: false;
    in-out property <bool> cloudflare-key-configured: false;
    in-out property <bool> chzzk-nid-aut-configured: false;
    in-out property <bool> chzzk-nid-ses-configured: false;
    in-out property <string> soop-password-draft: "";
    in-out property <string> cloudflare-key-draft: "";
    in-out property <string> chzzk-nid-aut-draft: "";
    in-out property <string> chzzk-nid-ses-draft: "";
    callback save-provider();
    callback test-soop-auth();

    in-out property <[LiveChannelRow]> live-rows;
    in-out property <bool> live-busy: true;
    in-out property <bool> live-loaded: false;
    in-out property <bool> live-running: false;
    in-out property <string> live-state: "불러오는 중";
    in-out property <string> live-engine: "-";
    in-out property <string> live-started-at: "-";
    in-out property <string> live-channel-count: "0";
    in-out property <string> live-recording-count: "0";
    in-out property <string> live-offline-count: "0";
    in-out property <string> live-error-count: "0";
    in-out property <string> live-message: "LIVE 런타임을 불러오는 중...";
    in-out property <string> live-password-target: "";
    in-out property <string> live-password-label: "";
    in-out property <string> live-password-draft: "";
    in-out property <[StorageDisplayRow]> storage-rows;
    in-out property <bool> storage-busy: true;
    in-out property <bool> storage-loaded: false;
    in-out property <string> storage-threshold: "-";
    in-out property <string> storage-database-size: "-";
    in-out property <string> storage-message: "저장 공간을 확인하는 중...";
    callback live-start();
    callback live-stop();
    callback live-refresh();
    callback storage-refresh();
    callback live-action(string, string);
    callback live-open-folder(string);
    callback live-password-submit(string, string);

    in-out property <[VodQualityRow]> vod-quality-rows;
    in-out property <[VodPartRow]> vod-part-rows;
    in-out property <bool> vod-busy: true;
    in-out property <bool> vod-loaded: false;
    in-out property <bool> vod-running: false;
    in-out property <bool> vod-can-analyze: false;
    in-out property <bool> vod-can-download: false;
    in-out property <bool> vod-merge: true;
    in-out property <string> vod-url: "";
    in-out property <string> vod-output-directory: "";
    in-out property <string> vod-platform: "-";
    in-out property <string> vod-state: "IDLE";
    in-out property <string> vod-state-tone: "neutral";
    in-out property <string> vod-message: "VOD 런타임을 불러오는 중...";
    in-out property <string> vod-runtime-message: "";
    in-out property <string> vod-title: "";
    in-out property <string> vod-streamer: "";
    in-out property <string> vod-streamer-id: "";
    in-out property <string> vod-current-part: "0";
    in-out property <string> vod-part-count: "0";
    in-out property <float> vod-percent: 0;
    in-out property <string> vod-percent-label: "0.0%";
    in-out property <string> vod-output-file: "";
    in-out property <string> vod-started-at: "-";
    in-out property <string> vod-finished-at: "-";
    callback vod-url-edited(string);
    callback vod-output-edited(string);
    callback vod-analyze();
    callback vod-pick-output();
    callback vod-select-quality(int);
    callback vod-toggle-part(int);
    callback vod-select-all-parts();
    callback vod-clear-parts();
    callback vod-toggle-merge();
    callback vod-download();
    callback vod-cancel();
    callback vod-refresh();

    in-out property <string> active-page: "LIVE";
    in-out property <string> settings-view: "General";
    in-out property <bool> runtime-ready: false;
    in-out property <string> runtime-status: "구성요소를 확인하는 중...";
    callback refresh-requested();
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> page;
    in property <image> nav-icon;
    height: 40px;
    vertical-stretch: 0;
    forward-focus: focus;
    border-radius: 6px;
    border-width: 1px;
    border-color: focus.has-focus ? Theme.accent : transparent;
    background: AppState.active-page == root.page ? Theme.selected : touch.has-hover ? Theme.surface : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.navigate(); }
    function navigate() {
        AppState.active-page = root.page;
        if root.page == "LIVE" { AppState.storage-refresh(); }
        if root.page == "Diagnostics" {
            MaintenanceState.section = "Diagnostics";
            MaintenanceState.refresh();
        }
    }
    Image {
        x: 12px; y: 11px; width: 18px; height: 18px;
        source: root.nav-icon;
        colorize: AppState.active-page == root.page ? Theme.accent : Theme.muted;
    }
    Text {
        x: 42px; width: parent.width - 54px; height: parent.height;
        text: root.label;
        color: AppState.active-page == root.page ? Theme.accent : Theme.secondary;
        font-size: 13px;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => { focus.focus(); root.navigate(); } }
    focus := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.navigate(); return accept;
            }
            return reject;
        }
    }
}

export component MainWindow inherits Window {
    channel-name-measure := VerticalLayout {
        visible: false;
        for row in AppState.channel-config-rows: Text { text: row.name; font-size: 13px; }
    }
    title: "Stream Archive";
    icon: @image-url("../assets/stream-archive-icon.png");
    preferred-width: 1120px;
    preferred-height: 720px;
    min-width: 1000px;
    min-height: 650px;
    background: Theme.canvas;
    default-font-size: 13px;
    init => { Palette.color-scheme = ColorScheme.dark; }

    HorizontalLayout {
        spacing: 0px;

        Rectangle {
            width: 190px;
            horizontal-stretch: 0;
            background: Theme.sidebar;
            VerticalLayout {
                padding: 14px;
                spacing: 6px;
                HorizontalLayout {
                    height: 52px; vertical-stretch: 0; spacing: 9px;
                    Image { width: 30px; height: 30px; source: @image-url("../assets/stream-archive-icon.png"); image-fit: contain; }
                    Text { text: "Stream Archive"; color: Theme.text; font-size: 15px; font-weight: 700; vertical-alignment: center; }
                }
                NavItem { label: "LIVE"; page: "LIVE"; nav-icon: @image-url("../assets/navigation/live.svg"); }
                NavItem { label: "채널"; page: "Channels"; nav-icon: @image-url("../assets/navigation/channels.svg"); }
                Rectangle { height: 12px; vertical-stretch: 0; background: transparent; }
                NavItem { label: "VOD 다운로드"; page: "VOD"; nav-icon: @image-url("../assets/navigation/vod.svg"); }
                NavItem { label: "대기열"; page: "Queue"; nav-icon: @image-url("../assets/navigation/queue.svg"); }
                NavItem { label: "기록"; page: "History"; nav-icon: @image-url("../assets/navigation/history.svg"); }
                Rectangle { height: 12px; vertical-stretch: 0; background: transparent; }
                NavItem { label: "설정"; page: "Settings"; nav-icon: @image-url("../assets/navigation/settings.svg"); }
                NavItem { label: "진단"; page: "Diagnostics"; nav-icon: @image-url("../assets/navigation/diagnostics.svg"); }
                Rectangle { vertical-stretch: 1; background: transparent; }
                Text { text: "v1.0.0"; color: Theme.muted; font-size: 11px; }
            }
        }

        Rectangle {
            background: Theme.canvas;
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 20px;
                spacing: 14px;

                VerticalLayout {
                    height: 56px; vertical-stretch: 0; spacing: 4px;
                    Text {
                        text: AppState.active-page == "VOD" ? "VOD 다운로드" : AppState.active-page == "Channels" ? "채널 관리" : AppState.active-page == "Queue" ? "다운로드 대기열" : AppState.active-page == "History" ? "기록" : AppState.active-page == "Settings" ? "설정" : AppState.active-page == "Diagnostics" ? "진단" : AppState.active-page;
                        color: Theme.text; font-size: 25px; font-weight: 700;
                    }
                    Text {
                        text: AppState.active-page == "LIVE" ? "방송 감시와 현재 녹화 상태를 확인합니다." : AppState.active-page == "Channels" ? "녹화 대상과 채널별 저장 경로를 설정합니다." : AppState.active-page == "VOD" ? "URL을 분석하고 화질과 PART를 선택해 다운로드합니다." : AppState.active-page == "Queue" ? "등록한 VOD 작업은 자동으로 실행됩니다." : AppState.active-page == "History" ? "LIVE 녹화와 VOD 작업 기록을 조회합니다." : AppState.active-page == "Settings" ? "저장 경로, 서비스 연결, 외부 도구와 백업을 설정합니다." : "실행 환경을 점검하고 런타임 로그를 확인합니다.";
                        color: Theme.muted; font-size: 13px;
                    }
                }
                if !AppState.runtime-ready: HorizontalLayout {
                    min-height: 32px; vertical-stretch: 0; spacing: 8px;
                    Text { text: AppState.runtime-status; color: Theme.warning; wrap: word-wrap; horizontal-stretch: 1; }
                    Button { text: "다시 확인"; icon: @image-url("../assets/actions/refresh.svg"); enabled: !AppState.settings-busy; clicked => { AppState.refresh-requested(); } }
                }

                if AppState.active-page == "LIVE": VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        height: 36px; vertical-stretch: 0; spacing: 8px;
                        StatusPill {
                            text: !AppState.live-loaded ? "상태 확인 중" : AppState.live-running ? "방송 감시 중" : "방송 감시 중지됨";
                            tone: AppState.live-running ? "ok" : "neutral"; dot: true; boxed: true;
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Button {
                            height: 34px;
                            icon: AppState.live-running ? @image-url("../assets/actions/stop.svg") : @image-url("../assets/actions/play.svg");
                            text: AppState.live-busy ? "처리 중…" : AppState.live-running ? "방송 감시 중지" : "방송 감시 시작";
                            primary: !AppState.live-running;
                            enabled: AppState.live-loaded && !AppState.live-busy;
                            clicked => {
                                if AppState.live-running { AppState.live-stop(); }
                                else { AppState.live-start(); }
                            }
                        }
                        Button {
                            height: 34px; text: "새로고침"; icon: @image-url("../assets/actions/refresh.svg");
                            enabled: AppState.live-loaded && !AppState.live-busy && !AppState.storage-busy;
                            clicked => { AppState.live-refresh(); AppState.storage-refresh(); }
                        }
                    }
                    HorizontalLayout {
                        height: 24px; vertical-stretch: 0; spacing: 18px; alignment: start;
                        Text { text: "●  채널 " + AppState.live-channel-count; color: Theme.secondary; font-size: 13px; }
                        Text { text: "●  녹화 중 " + AppState.live-recording-count; color: Theme.success; font-size: 13px; }
                        Text { text: "●  오프라인 " + AppState.live-offline-count; color: Theme.muted; font-size: 13px; }
                        Text { text: "●  오류 " + AppState.live-error-count; color: Theme.danger; font-size: 13px; }
                    }
                    Text { text: AppState.live-message; color: Theme.muted; wrap: word-wrap; font-size: 12px; vertical-stretch: 0; }
                    Text { text: "엔진: " + AppState.live-engine + " · 시작: " + AppState.live-started-at; color: Theme.muted; font-size: 12px; vertical-stretch: 0; wrap: word-wrap; }
                    if AppState.live-password-target != "": Rectangle {
                        height: 108px;
                        vertical-stretch: 0;
                        background: Theme.warning-surface;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 6px;
                            Text { text: "보호된 방송 · " + AppState.live-password-label; color: Theme.warning; font-weight: 700; }
                            HorizontalLayout {
                                height: 34px;
                                vertical-stretch: 0;
                                spacing: 8px;
                                LineEdit {
                                    height: 34px;
                                    text <=> AppState.live-password-draft;
                                    input-type: password;
                                    enabled: !AppState.live-busy;
                                }
                                Button {
                                    height: 34px;
                                    text: "비밀번호 입력";
                                    enabled: !AppState.live-busy && AppState.live-password-draft != "";
                                    clicked => { AppState.live-password-submit(AppState.live-password-target, AppState.live-password-draft); }
                                }
                                Button {
                                    height: 34px;
                                    text: "취소";
                                    enabled: !AppState.live-busy;
                                    clicked => {
                                        AppState.live-password-target = "";
                                        AppState.live-password-label = "";
                                        AppState.live-password-draft = "";
                                    }
                                }
                            }
                            Text { text: "비밀번호는 메모리에만 유지되며 설정이나 SQLite에 저장되지 않습니다."; color: Theme.warning; font-size: 12px; }
                        }
                    }

                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding: 2px;
                            spacing: 6px;
                            alignment: start;
                            if AppState.live-rows.length == 0: Rectangle {
                                height: 82px;
                                vertical-stretch: 0;
                                background: Theme.surface;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: Theme.border;
                                VerticalLayout {
                                    padding: 16px;
                                    Text { text: "현재 LIVE 런타임에 등록된 채널이 없습니다. 채널 탭에서 채널을 추가하세요."; color: Theme.muted; }
                                }
                            }
                            for row in AppState.live-rows: Rectangle {
                                min-height: max(82px, live-content.min-height);
                                vertical-stretch: 0;
                                background: Theme.surface; border-radius: 8px;
                                border-width: 1px; border-color: Theme.border;
                                live-content := VerticalLayout {
                                    padding: 12px; spacing: 10px;
                                    HorizontalLayout {
                                        spacing: 12px;
                                    PlatformBadge { platform: row.platform; }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 5px;

                                        Text {
                                            min-height: 24px;
                                            vertical-stretch: 0;
                                            text: row.name != "" ? row.name : row.account;
                                            color: Theme.text;
                                            font-size: 14px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                            wrap: word-wrap;
                                        }
                                        Text { text: row.account; color: Theme.muted; font-size: 12px; }
                                        if row.title != "": Text { text: row.title; color: Theme.secondary; wrap: word-wrap; }
                                        if row.bno != "": Text { text: "방송: " + row.bno; color: Theme.muted; font-size: 12px; }
                                        if row.file != "": Text { text: "파일: " + row.file; color: Theme.secondary; wrap: word-wrap; font-size: 12px; }
                                        if row.size != "" || row.started-at != "": Text {
                                            text: (row.size != "" ? "크기: " + row.size : "") + (row.started-at != "" ? "  ·  시작: " + row.started-at : "");
                                            color: Theme.muted;
                                            font-size: 12px;
                                        }
                                        if row.suppressed: Text {
                                            text: "현재 방송은 방송이 바뀌거나 모니터링을 재개할 때까지 제외됩니다.";
                                            color: Theme.warning;
                                            font-size: 12px;
                                            wrap: word-wrap;
                                        }
                                        if row.detail != "": Text {
                                            text: row.detail;
                                            color: row.status-tone == "error" ? Theme.danger : Theme.muted;
                                            font-size: 12px;
                                            wrap: word-wrap;
                                        }
                                    }

                                        if root.width >= 1340px: LiveActions { channel: row; }
                                    }
                                    if root.width < 1340px: HorizontalLayout {
                                        Rectangle { horizontal-stretch: 1; }
                                        LiveActions { channel: row; }
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: AppState.storage-rows.length < 2 ? 142px : 184px; vertical-stretch: 0;
                        background: Theme.surface; border-radius: 8px;
                        border-width: 1px; border-color: Theme.border;
                        VerticalLayout {
                            padding: 12px; spacing: 12px;
                            HorizontalLayout {
                                height: 28px; vertical-stretch: 0; spacing: 8px;
                                Text { text: "저장 공간"; color: Theme.text; font-weight: 600; horizontal-stretch: 1; vertical-alignment: center; }
                                Text { text: "최소 여유 " + AppState.storage-threshold; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                                Button { text: "새로고침"; enabled: !AppState.storage-busy; clicked => { AppState.storage-refresh(); } }
                            }
                            if AppState.storage-message != "": Text { text: AppState.storage-message; color: Theme.muted; font-size: 12px; wrap: word-wrap; vertical-stretch: 0; }
                            ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    spacing: 12px; alignment: start;
                                    if AppState.storage-rows.length == 0: Text { text: "표시할 저장소가 없습니다."; color: Theme.muted; }
                                    for row in AppState.storage-rows: Rectangle {
                                        min-height: max(34px, volume-content.min-height); vertical-stretch: 0;
                                        background: transparent;
                                        volume-content := HorizontalLayout {
                                            spacing: 14px;
                                            Text { width: 42px; vertical-alignment: center; text: row.volume; color: Theme.text; font-weight: 600; wrap: word-wrap; }
                                            VerticalLayout {
                                                horizontal-stretch: 1; spacing: 2px;
                                                Text { text: row.capacity + " · 사용률 " + row.used; color: Theme.secondary; font-size: 12px; wrap: word-wrap; }
                                                if row.detail != "": Text { text: row.detail; color: row.status-tone == "error" ? Theme.danger : Theme.warning; font-size: 12px; wrap: word-wrap; }
                                            }
                                            StatusPill { text: row.status; tone: row.status-tone; boxed: true; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if AppState.active-page == "Channels": VerticalLayout {
                    spacing: 10px;
                    HorizontalLayout {
                        height: 34px; vertical-stretch: 0; spacing: 8px;
                        Text { text: AppState.channels-dirty ? "● 저장하지 않은 변경사항" : "등록 채널 " + AppState.channel-config-rows.length; color: AppState.channels-dirty ? Theme.warning : Theme.muted; horizontal-stretch: 1; vertical-alignment: center; }
                        Button { text: "+ 채널 추가"; enabled: AppState.config-loaded && !AppState.config-busy; clicked => { AppState.channel-add(); } }
                        Button { text: "채널 저장"; primary: true; enabled: AppState.config-loaded && !AppState.config-busy && AppState.channels-dirty; clicked => { AppState.save-channels(); } }
                        Button { text: "저장값 다시 불러오기"; enabled: AppState.config-loaded && !AppState.config-busy; clicked => { AppState.reload-configuration(); } }
                    }
                    Text { text: AppState.config-message; color: Theme.muted; font-size: 12px; wrap: word-wrap; vertical-stretch: 0; }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 7px; alignment: start;
                            if AppState.channel-config-rows.length == 0: Text { text: "등록된 채널이 없습니다. 채널을 추가하고 저장하세요."; color: Theme.muted; wrap: word-wrap; }
                            for row[index] in AppState.channel-config-rows: Rectangle {
                                min-height: max(72px, channel-content.min-height); vertical-stretch: 0;
                                background: Theme.surface; border-radius: 8px;
                                border-width: 1px; border-color: Theme.border;
                                channel-content := HorizontalLayout {
                                    padding: 10px; spacing: 6px;
                                    VerticalLayout {
                                        width: 96px; spacing: 4px;
                                        Text { text: "플랫폼"; color: Theme.muted; font-size: 12px; }
                                        ComboBox { model: ["SOOP", "CHZZK"]; min-width: 0px; current-index: row.platform == "CHZZK" ? 1 : 0; enabled: !AppState.config-busy; selected(value) => { AppState.channel-select-platform(index, value); } }
                                    }
                                    VerticalLayout {
                                        width: 82px; spacing: 4px;
                                        Text { text: "방송 감시"; color: Theme.muted; font-size: 12px; }
                                        Button { text: row.enabled ? "사용" : "사용 안 함"; selected: row.enabled; enabled: !AppState.config-busy; clicked => { AppState.channel-toggle-enabled(index); } }
                                    }
                                    VerticalLayout {
                                        width: min(max(180px, channel-name-measure.min-width + 24px), max(70px, min(320px, root.width - 960px))); spacing: 4px;
                                        Text { text: "채널 이름"; color: Theme.muted; font-size: 12px; }
                                        LineEdit { min-width: 0px; height: 34px; font-size: 13px; text <=> row.name; enabled: !AppState.config-busy; edited(value) => { AppState.channel-edited(index, "name", value); } }
                                    }
                                    VerticalLayout {
                                        width: min(270px, 210px + max(0px, root.width - 1000px) * 0.5); spacing: 4px;
                                        Text { text: "계정 / 채널 ID"; color: Theme.muted; font-size: 12px; }
                                        LineEdit { min-width: 0px; height: 34px; font-size: 12px; text <=> row.account; enabled: !AppState.config-busy; edited(value) => { AppState.channel-edited(index, "account", value); } accepted => { AppState.channel-resolve(index); } }
                                    }
                                    VerticalLayout {
                                        min-width: 80px; horizontal-stretch: 2; spacing: 4px;
                                        Text { text: "저장 폴더"; color: Theme.muted; font-size: 12px; }
                                        LineEdit { min-width: 0px; height: 34px; font-size: 13px; text <=> row.outdir; placeholder-text: "기본 경로 사용"; enabled: !AppState.config-busy; edited(value) => { AppState.channel-edited(index, "outdir", value); } }
                                    }
                                    VerticalLayout { alignment: end; Button { text: "이름 조회"; enabled: !AppState.config-busy && row.account != ""; clicked => { AppState.channel-resolve(index); } } }
                                    VerticalLayout { alignment: end; Button { text: "삭제"; danger: true; enabled: !AppState.config-busy; clicked => { AppState.channel-remove(index); } } }
                                }
                            }
                        }
                    }
                    Text { text: "SOOP 계정 ID / CHZZK channel ID를 입력합니다. 이름 조회로 표시 이름을 가져올 수 있습니다."; color: Theme.muted; font-size: 12px; wrap: word-wrap; vertical-stretch: 0; }
                }

                if AppState.active-page == "VOD": VerticalLayout {
                    spacing: 9px;
                    HorizontalLayout {
                        height: 36px;
                        vertical-stretch: 0;
                        spacing: 8px;
                        Text {
                            text: "URL 분석 → 화질 / PART 선택 → 다운로드";
                            color: Theme.text;
                            font-size: 18px;
                            font-weight: 700;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Button {
                            height: 34px;
                            text: "분석";
                            primary: true;
                            enabled: AppState.vod-loaded && AppState.vod-can-analyze && !AppState.vod-busy && !AppState.vod-running;
                            clicked => { AppState.vod-analyze(); }
                        }
                        Button {
                            height: 34px;
                            text: "새로고침";
                            enabled: AppState.vod-loaded && !AppState.vod-busy;
                            clicked => { AppState.vod-refresh(); }
                        }
                        Button {
                            height: 34px;
                            text: "취소";
                            enabled: AppState.vod-loaded && AppState.vod-running && !AppState.vod-busy;
                            clicked => { AppState.vod-cancel(); }
                        }
                    }
                    Rectangle {
                        min-height: max(72px, content-2.min-height);
                        vertical-stretch: 0;
                        background: Theme.surface;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.border;
                        content-2 := VerticalLayout {
                            padding: 11px;
                            spacing: 5px;
                            LineEdit {
                                height: 34px;
                                vertical-stretch: 0;
                                text <=> AppState.vod-url;
                                enabled: !AppState.vod-busy && !AppState.vod-running;
                                placeholder-text: "SOOP / CHZZK VOD URL";
                                edited(value) => { AppState.vod-url-edited(value); }
                                accepted => { AppState.vod-analyze(); }
                            }
                            Text { text: AppState.vod-message; color: Theme.secondary; font-size: 12px; wrap: word-wrap; }
                        }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding: 2px;
                            spacing: 10px;
                            alignment: start;
                            if AppState.vod-title != "" || AppState.vod-streamer != "": Rectangle {
                                min-height: max(82px, content-3.min-height);
                                vertical-stretch: 0;
                                background: Theme.surface;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: Theme.border;
                                content-3 := VerticalLayout {
                                    padding: 11px;
                                    spacing: 4px;
                                    Text { text: AppState.vod-title != "" ? AppState.vod-title : "VOD 정보"; color: Theme.text; font-size: 15px; font-weight: 700; wrap: word-wrap; }
                                    Text { text: "스트리머: " + AppState.vod-streamer + (AppState.vod-streamer-id != "" ? "  ·  " + AppState.vod-streamer-id : ""); color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                                    Text { text: "PART 수: " + AppState.vod-part-count; color: Theme.muted; font-size: 11px; }
                                }
                            }

                            Rectangle {
                                min-height: max(108px, content-4.min-height);
                                vertical-stretch: 0;
                                background: Theme.surface;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: Theme.border;
                                content-4 := VerticalLayout {
                                    padding: 12px;
                                    spacing: 5px;
                                    HorizontalLayout {
                                        height: 24px;
                                        vertical-stretch: 0;
                                        spacing: 8px;
                                        Text {
                                            text: AppState.vod-platform + " · " + AppState.vod-state;
                                            color: AppState.vod-state-tone == "error" ? Theme.danger : AppState.vod-state-tone == "warn" ? Theme.warning : AppState.vod-state-tone == "ok" ? Theme.success : Theme.secondary;
                                            font-size: 16px;
                                            font-weight: 700;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                        }
                                        Text { text: AppState.vod-current-part + " / " + AppState.vod-part-count + "개 PART"; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                                        Text { text: AppState.vod-percent-label; color: Theme.text; font-weight: 700; vertical-alignment: center; }
                                    }
                                    Rectangle {
                                        height: 8px;
                                        vertical-stretch: 0;
                                        background: Theme.border;
                                        border-radius: 4px;
                                        Rectangle {
                                            x: 0px;
                                            y: 0px;
                                            height: parent.height;
                                            width: parent.width * clamp(AppState.vod-percent, 0, 100) / 100;
                                            background: Theme.accent;
                                            border-radius: 4px;
                                        }
                                    }
                                    Text { text: AppState.vod-runtime-message; color: Theme.secondary; font-size: 11px; wrap: word-wrap; }
                                    Text {
                                        text: "시작: " + AppState.vod-started-at + "  ·  완료: " + AppState.vod-finished-at;
                                        color: Theme.muted;
                                        font-size: 11px;
                                        wrap: word-wrap;
                                    }
                                    if AppState.vod-output-file != "": Text { text: "출력: " + AppState.vod-output-file; color: Theme.secondary; font-size: 11px; wrap: word-wrap; }
                                }
                            }

                            HorizontalLayout {
                                min-height: 166px;
                                vertical-stretch: 0;
                                spacing: 10px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: Theme.surface;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 6px;
                                        Text { text: "화질"; color: Theme.text; font-size: 14px; font-weight: 700; }
                                        ScrollView {
                                            vertical-stretch: 1;
                                            VerticalLayout {
                                                spacing: 5px;
                                                if AppState.vod-quality-rows.length == 0: Text { text: "VOD를 분석하면 화질 목록이 표시됩니다."; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                                                for row[index] in AppState.vod-quality-rows: Button {
                                                    height: 30px;
                                                    text: row.label; selected: row.selected;
                                                    enabled: !AppState.vod-busy && !AppState.vod-running;
                                                    clicked => { AppState.vod-select-quality(index); }
                                                }
                                            }
                                        }
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: Theme.surface;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 6px;
                                        HorizontalLayout {
                                            height: 30px;
                                            vertical-stretch: 0;
                                            spacing: 6px;
                                            Text { text: "PART"; color: Theme.text; font-size: 14px; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
                                            Button {
                                                height: 28px;
                                                text: "전체 선택";
                                                enabled: AppState.vod-part-rows.length > 0 && !AppState.vod-busy && !AppState.vod-running;
                                                clicked => { AppState.vod-select-all-parts(); }
                                            }
                                            Button {
                                                height: 28px;
                                                text: "선택 해제";
                                                enabled: AppState.vod-part-rows.length > 0 && !AppState.vod-busy && !AppState.vod-running;
                                                clicked => { AppState.vod-clear-parts(); }
                                            }
                                        }
                                        ScrollView {
                                            vertical-stretch: 1;
                                            VerticalLayout {
                                                spacing: 5px;
                                                if AppState.vod-part-rows.length == 0: Text { text: "VOD를 분석하면 PART 목록이 표시됩니다."; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                                                for row[index] in AppState.vod-part-rows: Button {
                                                    height: 30px;
                                                    text: "PART " + row.part + " · " + row.duration; selected: row.selected;
                                                    enabled: !AppState.vod-busy && !AppState.vod-running;
                                                    clicked => { AppState.vod-toggle-part(index); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                height: 100px;
                                vertical-stretch: 0;
                                background: Theme.surface;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: Theme.border;
                                VerticalLayout {
                                    padding: 11px;
                                    spacing: 6px;
                                    HorizontalLayout {
                                        height: 34px;
                                        vertical-stretch: 0;
                                        spacing: 8px;
                                        Text { text: "저장 경로"; color: Theme.text; font-size: 15px; font-weight: 700; vertical-alignment: center; }
                                        LineEdit {
                                            height: 34px;
                                            vertical-stretch: 0;
                                            horizontal-stretch: 1;
                                            text <=> AppState.vod-output-directory;
                                            enabled: !AppState.vod-busy && !AppState.vod-running;
                                            placeholder-text: "기본 설정 경로 또는 직접 지정";
                                            edited(value) => { AppState.vod-output-edited(value); }
                                        }
                                        Button {
                                            height: 32px;
                                            text: "찾아보기...";
                                            enabled: !AppState.vod-busy && !AppState.vod-running;
                                            clicked => { AppState.vod-pick-output(); }
                                        }
                                        Button {
                                            height: 32px;
                                            text: AppState.vod-merge ? "병합: 켜짐" : "병합: 꺼짐"; selected: AppState.vod-merge;
                                            enabled: !AppState.vod-busy && !AppState.vod-running;
                                            clicked => { AppState.vod-toggle-merge(); }
                                        }
                                        Button {
                                            height: 32px;
                                            text: "다운로드";
                                            primary: true;
                                            enabled: AppState.vod-loaded && AppState.vod-can-download && !AppState.vod-busy && !AppState.vod-running;
                                            clicked => { AppState.vod-download(); }
                                        }
                                        Button {
                                            height: 32px;
                                            text: "대기열에 추가";
                                            enabled: AppState.vod-loaded && AppState.vod-can-download && !AppState.vod-busy && !AppState.vod-running;
                                            clicked => { QueueHistoryLocal.enqueue-current(); }
                                        }

                                    }
                                    Text { text: "외부 도구 경로와 서비스 인증정보는 설정에서 변경합니다."; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                                }
                            }
                        }
                    }
                }
                if AppState.active-page == "Queue": QueuePage { vertical-stretch: 1; }
                if AppState.active-page == "History": HistoryPage { vertical-stretch: 1; }
                if AppState.active-page == "Settings": VerticalLayout {
                    spacing: 9px;
                    HorizontalLayout {
                        height: 36px;
                        vertical-stretch: 0;
                        spacing: 8px;
                        Text {
                            text: "설정";
                            color: Theme.text;
                            font-size: 18px;
                            font-weight: 700;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Button {
                            width: 72px;
                            height: 32px;
                            text: "일반";
                            selected: AppState.settings-view == "General";
                            clicked => { AppState.settings-view = "General"; }
                        }
                        Button {
                            width: 110px;
                            height: 32px;
                            text: "백업 / 복원";
                            selected: AppState.settings-view == "Manage";
                            clicked => { AppState.settings-view = "Manage"; MaintenanceState.section = "Backup"; MaintenanceState.refresh(); }
                        }
                    }

                    if AppState.settings-view == "General": VerticalLayout {
                        spacing: 9px;
                        Text { text: "서비스 연결 및 실행 설정"; color: Theme.text; font-size: 18px; font-weight: 700; }
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                padding: 3px;
                                spacing: 12px;

                                Rectangle {
                                    min-height: max(330px, content-5.min-height);
                                    vertical-stretch: 0;
                                    background: Theme.surface;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    content-5 := VerticalLayout {
                                        padding: 14px;
                                        spacing: 8px;
                                        Text { text: "서비스 연결 및 인증"; color: Theme.text; font-size: 18px; font-weight: 700; }
                                        Text { text: AppState.config-message; color: Theme.secondary; wrap: word-wrap; font-size: 12px; }
                                        HorizontalLayout {
                                            height: 34px;
                                            vertical-stretch: 0;
                                            spacing: 8px;
                                            Button {
                                                height: 32px;
                                                text: "연결 정보 저장";
                                                primary: true;
                                                enabled: AppState.config-loaded && !AppState.config-busy;
                                                clicked => { AppState.save-provider(); }
                                            }
                                            Button {
                                                height: 32px;
                                                text: "SOOP + Worker 테스트";
                                                enabled: AppState.config-loaded && !AppState.config-busy
                                                && AppState.soop-username != ""
                                                && AppState.cloudflare-worker-url != ""
                                                && AppState.soop-password-configured
                                                && AppState.cloudflare-key-configured;
                                                clicked => { AppState.test-soop-auth(); }
                                            }
                                            Button {
                                                height: 32px;
                                                text: "저장값 다시 불러오기";
                                                enabled: AppState.config-loaded && !AppState.config-busy;
                                                clicked => { AppState.reload-configuration(); }
                                            }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                        }
                                        HorizontalLayout {
                                            height: 58px;
                                            vertical-stretch: 0;
                                            spacing: 10px;
                                            VerticalLayout {
                                                spacing: 4px;
                                                Text { text: "SOOP 사용자명"; color: Theme.text; font-weight: 600; font-size: 12px; }
                                                LineEdit { height: 34px; text <=> AppState.soop-username; enabled: !AppState.config-busy; }
                                            }
                                            VerticalLayout {
                                                spacing: 4px;
                                                Text { text: "Cloudflare Worker URL"; color: Theme.text; font-weight: 600; font-size: 12px; }
                                                LineEdit { height: 34px; text <=> AppState.cloudflare-worker-url; enabled: !AppState.config-busy; }
                                            }
                                        }
                                        HorizontalLayout {
                                            height: 58px;
                                            vertical-stretch: 0;
                                            spacing: 10px;
                                            VerticalLayout {
                                                spacing: 4px;
                                                Text { text: "SOOP 비밀번호 · " + (AppState.soop-password-configured ? "설정됨" : "미설정"); color: AppState.soop-password-configured ? Theme.success : Theme.warning; font-size: 11px; }
                                                LineEdit { height: 34px; text <=> AppState.soop-password-draft; input-type: password; enabled: !AppState.config-busy; }
                                            }
                                            VerticalLayout {
                                                spacing: 4px;
                                                Text { text: "Worker API key · " + (AppState.cloudflare-key-configured ? "설정됨" : "미설정"); color: AppState.cloudflare-key-configured ? Theme.success : Theme.warning; font-size: 11px; }
                                                LineEdit { height: 34px; text <=> AppState.cloudflare-key-draft; input-type: password; enabled: !AppState.config-busy; }
                                            }
                                        }
                                        HorizontalLayout {
                                            height: 58px;
                                            vertical-stretch: 0;
                                            spacing: 10px;
                                            VerticalLayout {
                                                spacing: 4px;
                                                Text { text: "CHZZK NID_AUT · " + (AppState.chzzk-nid-aut-configured ? "설정됨" : "미설정"); color: AppState.chzzk-nid-aut-configured ? Theme.success : Theme.warning; font-size: 11px; }
                                                LineEdit { height: 34px; text <=> AppState.chzzk-nid-aut-draft; input-type: password; enabled: !AppState.config-busy; }
                                            }
                                            VerticalLayout {
                                                spacing: 4px;
                                                Text { text: "CHZZK NID_SES · " + (AppState.chzzk-nid-ses-configured ? "설정됨" : "미설정"); color: AppState.chzzk-nid-ses-configured ? Theme.success : Theme.warning; font-size: 11px; }
                                                LineEdit { height: 34px; text <=> AppState.chzzk-nid-ses-draft; input-type: password; enabled: !AppState.config-busy; }
                                            }
                                        }
                                        Text {
                                            text: "비밀 값 입력칸을 비워두면 기존 저장값을 유지합니다. 비밀 값은 플랫폼 보안 저장소에서 보호되며 UI로 다시 읽어오지 않습니다.";
                                            color: Theme.muted;
                                            wrap: word-wrap;
                                            font-size: 11px;
                                        }
                                    }
                                }

                                Rectangle {
                                    min-height: max(72px, content-6.min-height);
                                    vertical-stretch: 0;
                                    background: Theme.surface;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    content-6 := VerticalLayout {
                                        padding: 12px;
                                        spacing: 6px;
                                        HorizontalLayout {
                                            height: 32px;
                                            vertical-stretch: 0;
                                            spacing: 8px;
                                            Text { text: "런타임 환경"; color: Theme.text; font-size: 17px; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
                                            Button {
                                                height: 30px;
                                                text: AppState.settings-dirty ? "변경사항 저장 *" : "변경사항 저장";
                                                primary: true;
                                                enabled: AppState.settings-loaded && !AppState.settings-busy && AppState.settings-dirty;
                                                clicked => { AppState.save-settings(); }
                                            }
                                            Button {
                                                height: 30px;
                                                text: "저장값 다시 불러오기";
                                                enabled: AppState.settings-loaded && !AppState.settings-busy;
                                                clicked => { AppState.reload-settings(); }
                                            }
                                        }
                                        Text { text: AppState.settings-message; wrap: word-wrap; color: Theme.muted; font-size: 11px; }
                                    }
                                }

                                for row[index] in AppState.settings-rows: Rectangle {
                                    min-height: max(88px, content-7.min-height);
                                    vertical-stretch: 0;
                                    background: Theme.surface;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    content-7 := VerticalLayout {
                                        padding: 12px;
                                        spacing: 6px;
                                        if row.key == "STREAM_ARCHIVE_DOWNLOAD_NOTIFICATIONS" && AppState.download-notifications-status != "": Text { text: AppState.download-notifications-status; wrap: word-wrap; color: Theme.muted; font-size: 11px; }
                                        Text { text: row.key == "OUTPUT_DIR" ? "기본 저장 경로 (LIVE / VOD)" : row.key == "QUALITY" ? "LIVE 기본 화질" : row.key == "CHECK_INTERVAL" ? "방송 감시 간격 (초)" : row.key == "MIN_FREE_SPACE_GB" ? "최소 여유 공간 (GB)" : row.key == "STREAMLINK_PATH" ? "Streamlink 경로" : row.key == "STREAMLINK_FALLBACK" ? "Streamlink 대체 경로" : row.key == "YT_DLP_PATH" ? "yt-dlp 경로" : row.key == "FFMPEG_PATH" ? "FFmpeg 경로" : row.key == "STREAM_ARCHIVE_CLOSE_ACTION" ? "창을 닫을 때" : row.key == "STREAM_ARCHIVE_DOWNLOAD_NOTIFICATIONS" ? "다운로드 완료·실패 알림" : row.key; color: Theme.text; font-weight: 600; font-size: 12px; }
                                        HorizontalLayout {
                                            height: 34px;
                                            vertical-stretch: 0;
                                            spacing: 8px;
                                            if row.key == "STREAM_ARCHIVE_CLOSE_ACTION": ComboBox {
                                                height: 34px;
                                                model: ["프로그램 종료", "시스템 트레이로 이동", "매번 확인"];
                                                current-index: row.value == "ASK" ? 2 : row.value == "TRAY" ? 1 : 0;
                                                enabled: !AppState.settings-busy;
                                                selected(value) => { AppState.setting-edited(index, self.current-index == 2 ? "ASK" : self.current-index == 1 ? "TRAY" : "EXIT"); }
                                            }
                                            if row.key == "STREAM_ARCHIVE_DOWNLOAD_NOTIFICATIONS": ComboBox {
                                                height: 34px;
                                                model: ["알림 사용", "알림 끄기"];
                                                current-index: row.value == "true" ? 0 : 1;
                                                enabled: !AppState.settings-busy;
                                                selected(value) => { AppState.setting-edited(index, self.current-index == 0 ? "true" : "false"); }
                                            }
                                            if row.key != "STREAM_ARCHIVE_CLOSE_ACTION" && row.key != "STREAM_ARCHIVE_DOWNLOAD_NOTIFICATIONS": LineEdit {
                                                height: 34px;
                                                text <=> row.value;
                                                enabled: !AppState.settings-busy;
                                                edited(value) => { AppState.setting-edited(index, value); }
                                            }
                                            if row.pickable: Button {
                                                width: 78px;
                                                height: 32px;
                                                text: "찾아보기...";
                                                enabled: !AppState.settings-busy;
                                                clicked => { AppState.pick-setting(index); }
                                            }
                                        }
                                        Text { text: row.description; color: Theme.muted; wrap: word-wrap; font-size: 11px; }
                                    }
                                }

                            }
                        }
                    }

                    if AppState.settings-view == "Manage": MaintenancePage {
                        diagnostics-page: false;
                        vertical-stretch: 1;
                    }
                }
                if AppState.active-page == "Diagnostics": MaintenancePage {
                    diagnostics-page: true;
                    vertical-stretch: 1;
                }
            }
        }
    }
    if AppState.close-dialog-visible: Rectangle {
        width: parent.width; height: parent.height; background: #00000099;
        TouchArea { }
        FocusScope {
            width: parent.width; height: parent.height;
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape && !AppState.close-choice-busy { AppState.close-dialog-visible = false; return accept; }
                return reject;
            }
        Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: 490px; height: close-content.min-height;
            background: Theme.surface; border-radius: 10px; border-width: 1px; border-color: Theme.border;
            close-content := VerticalLayout {
                padding: 22px; spacing: 14px;
                Text { text: "창을 닫을 때 어떻게 할까요?"; color: Theme.text; font-size: 18px; font-weight: 600; }
                Text { text: "트레이로 이동하면 녹화·다운로드·방송 감시가 계속됩니다."; color: Theme.secondary; wrap: word-wrap; }
                CheckBox { text: "이 선택을 기억하기"; checked <=> AppState.close-remember; enabled: !AppState.close-choice-busy; }
                if AppState.close-choice-error != "": Text { text: AppState.close-choice-error; color: Theme.danger; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px;
                    Button { text: "트레이로 이동"; enabled: !AppState.close-choice-busy; clicked => { AppState.close-choice("TRAY", AppState.close-remember); } }
                    Button { text: "프로그램 종료"; enabled: !AppState.close-choice-busy; clicked => { AppState.close-choice("EXIT", AppState.close-remember); } }
                    Button { text: "취소"; enabled: !AppState.close-choice-busy; clicked => { AppState.close-dialog-visible = false; } }
                }
            }
        }
        }
    }

}
