import { Button, LineEdit, ScrollView } from "std-widgets.slint";
import { QueuePage, HistoryPage, QueueHistoryState as QueueHistoryLocal } from "queue-history.slint";
import { MaintenancePage } from "maintenance.slint";
export { QueueHistoryState } from "queue-history.slint";
export { MaintenanceState, MaintenanceBackupRow, MaintenanceDiagnosticRow, MaintenanceLogRow } from "maintenance.slint";

export struct SettingRow { key: string, value: string, description: string, pickable: bool }
export struct DiagnosticRow { name: string, status: string, detail: string }
export struct ChannelConfigRow {
    platform: string,
    enabled: bool,
    name: string,
    account: string,
    outdir: string,
}
export struct LiveChannelRow {
    target: string,
    platform: string,
    name: string,
    account: string,
    status: string,
    status-label: string,
    status-tone: string,
    title: string,
    bno: string,
    file: string,
    size: string,
    started-at: string,
    suppressed: bool,
    detail: string,
    can-stop-once: bool,
    can-resume: bool,
    can-recheck: bool,
    password-required: bool,
}
export struct VodQualityRow {
    value: string,
    label: string,
    selected: bool,
}
export struct VodPartRow {
    part: string,
    duration: string,
    selected: bool,
}

export global AppState {
    in-out property <[SettingRow]> settings-rows;
    in-out property <[DiagnosticRow]> diagnostics-rows;
    in-out property <bool> settings-busy: true;
    in-out property <bool> settings-loaded: false;
    in-out property <bool> settings-dirty: false;
    in-out property <string> settings-message: "설정을 불러오는 중...";
    callback setting-edited(int, string);
    callback save-settings();
    callback reload-settings();
    callback pick-setting(int);

    in-out property <[ChannelConfigRow]> channel-config-rows;
    in-out property <bool> config-busy: true;
    in-out property <bool> config-loaded: false;
    in-out property <bool> channels-dirty: false;
    in-out property <string> config-message: "채널 및 공급자 설정을 불러오는 중...";
    callback channel-add();
    callback channel-remove(int);
    callback channel-edited(int, string, string);
    callback channel-toggle-enabled(int);
    callback channel-toggle-platform(int);
    callback channel-resolve(int);
    callback save-channels();
    callback reload-configuration();

    in-out property <string> soop-username: "";
    in-out property <string> cloudflare-worker-url: "";
    in-out property <bool> soop-password-configured: false;
    in-out property <bool> cloudflare-key-configured: false;
    in-out property <bool> chzzk-nid-aut-configured: false;
    in-out property <bool> chzzk-nid-ses-configured: false;
    in-out property <string> soop-password-draft: "";
    in-out property <string> cloudflare-key-draft: "";
    in-out property <string> chzzk-nid-aut-draft: "";
    in-out property <string> chzzk-nid-ses-draft: "";
    callback save-provider();
    callback test-soop-auth();

    in-out property <[LiveChannelRow]> live-rows;
    in-out property <bool> live-busy: true;
    in-out property <bool> live-loaded: false;
    in-out property <bool> live-running: false;
    in-out property <string> live-state: "불러오는 중";
    in-out property <string> live-engine: "-";
    in-out property <string> live-started-at: "-";
    in-out property <string> live-channel-count: "0";
    in-out property <string> live-recording-count: "0";
    in-out property <string> live-offline-count: "0";
    in-out property <string> live-error-count: "0";
    in-out property <string> live-message: "LIVE 런타임을 불러오는 중...";
    in-out property <string> live-password-target: "";
    in-out property <string> live-password-label: "";
    in-out property <string> live-password-draft: "";
    callback live-start();
    callback live-stop();
    callback live-refresh();
    callback live-action(string, string);
    callback live-password-submit(string, string);

    in-out property <[VodQualityRow]> vod-quality-rows;
    in-out property <[VodPartRow]> vod-part-rows;
    in-out property <bool> vod-busy: true;
    in-out property <bool> vod-loaded: false;
    in-out property <bool> vod-running: false;
    in-out property <bool> vod-can-analyze: false;
    in-out property <bool> vod-can-download: false;
    in-out property <bool> vod-merge: true;
    in-out property <string> vod-url: "";
    in-out property <string> vod-output-directory: "";
    in-out property <string> vod-platform: "-";
    in-out property <string> vod-state: "IDLE";
    in-out property <string> vod-state-tone: "neutral";
    in-out property <string> vod-message: "VOD 런타임을 불러오는 중...";
    in-out property <string> vod-runtime-message: "";
    in-out property <string> vod-title: "";
    in-out property <string> vod-streamer: "";
    in-out property <string> vod-streamer-id: "";
    in-out property <string> vod-current-part: "0";
    in-out property <string> vod-part-count: "0";
    in-out property <float> vod-percent: 0;
    in-out property <string> vod-percent-label: "0.0%";
    in-out property <string> vod-output-file: "";
    in-out property <string> vod-started-at: "-";
    in-out property <string> vod-finished-at: "-";
    callback vod-url-edited(string);
    callback vod-output-edited(string);
    callback vod-analyze();
    callback vod-pick-output();
    callback vod-select-quality(int);
    callback vod-toggle-part(int);
    callback vod-select-all-parts();
    callback vod-clear-parts();
    callback vod-toggle-merge();
    callback vod-download();
    callback vod-cancel();
    callback vod-refresh();

    in-out property <string> active-page: "LIVE";
    in-out property <bool> runtime-ready: false;
    in-out property <string> runtime-status: "런타임 초기화 중...";
    callback refresh-requested();
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> page;
    height: 42px;
    vertical-stretch: 0;
    border-radius: 8px;
    background: AppState.active-page == root.page ? #334155 : transparent;

    Text {
        x: 14px;
        width: parent.width - 28px;
        height: parent.height;
        text: root.label;
        color: AppState.active-page == root.page ? #f8fafc : #cbd5e1;
        vertical-alignment: center;
        font-size: 15px;
    }

    TouchArea { clicked => { AppState.active-page = root.page; } }
}

component LiveMetric inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: 74px;
    vertical-stretch: 0;
    horizontal-stretch: 1;
    background: #ffffff;
    border-radius: 10px;
    border-width: 1px;
    border-color: #e2e8f0;
    VerticalLayout {
        padding: 12px;
        spacing: 4px;
        Text { text: root.label; color: #64748b; font-size: 11px; }
        Text { text: root.value; color: #0f172a; font-size: 21px; font-weight: 700; }
    }
}

export component MainWindow inherits Window {
    title: "Stream Archive";
    preferred-width: 1120px;
    preferred-height: 720px;
    min-width: 1000px;
    min-height: 650px;
    background: #f1f5f9;

    HorizontalLayout {
        spacing: 0px;

        Rectangle {
            width: 224px;
            horizontal-stretch: 0;
            background: #0f172a;
            VerticalLayout {
                padding: 18px;
                spacing: 9px;
                Text { text: "Stream Archive"; color: #f8fafc; font-size: 21px; font-weight: 700; }
                Text { text: "네이티브 데스크톱"; color: #94a3b8; font-size: 12px; }
                Rectangle { height: 10px; vertical-stretch: 0; background: transparent; }
                NavItem { label: "LIVE"; page: "LIVE"; }
                NavItem { label: "채널"; page: "Channels"; }
                NavItem { label: "VOD"; page: "VOD"; }
                NavItem { label: "대기열"; page: "Queue"; }
                NavItem { label: "기록"; page: "History"; }
                NavItem { label: "관리"; page: "Maintenance"; }
                NavItem { label: "설정"; page: "Settings"; }
                Rectangle { vertical-stretch: 1; background: transparent; }
                Rectangle {
                    height: 78px;
                    vertical-stretch: 0;
                    border-radius: 8px;
                    background: AppState.runtime-ready ? #132a24 : #3a1f23;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 4px;
                        Text {
                            text: AppState.runtime-ready ? "● 환경 정상" : "● 환경 확인 필요";
                            color: AppState.runtime-ready ? #86efac : #fda4af;
                            font-size: 13px;
                            font-weight: 600;
                        }
                        Text { text: AppState.runtime-status; color: #cbd5e1; font-size: 11px; wrap: word-wrap; }
                    }
                }
            }
        }

        Rectangle {
            background: #f1f5f9;
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 24px;
                spacing: 14px;

                HorizontalLayout {
                    height: 54px;
                    vertical-stretch: 0;
                    spacing: 12px;
                    VerticalLayout {
                        spacing: 3px;
                        horizontal-stretch: 1;
                        Text { text: AppState.active-page == "Channels" ? "채널" : AppState.active-page == "Queue" ? "대기열" : AppState.active-page == "History" ? "기록" : AppState.active-page == "Maintenance" ? "관리" : AppState.active-page == "Settings" ? "설정" : AppState.active-page; color: #0f172a; font-size: 27px; font-weight: 700; }
                        Text { text: "Phase 21 Slint native shell"; color: #64748b; font-size: 13px; }
                    }
                    Button {
                        height: 36px;
                        vertical-stretch: 0;
                        text: "런타임 새로고침";
                        enabled: !AppState.settings-busy;
                        clicked => { AppState.refresh-requested(); }
                    }
                }

                if AppState.active-page == "LIVE": VerticalLayout {
                    spacing: 9px;
                    HorizontalLayout {
                        height: 36px;
                        vertical-stretch: 0;
                        spacing: 8px;
                        Text {
                            text: "Watcher: " + AppState.live-state;
                            color: AppState.live-running ? #15803d : #475569;
                            font-size: 18px;
                            font-weight: 700;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Button {
                            height: 34px;
                            text: "Watcher 시작";
                            enabled: AppState.live-loaded && !AppState.live-busy && !AppState.live-running;
                            clicked => { AppState.live-start(); }
                        }
                        Button {
                            height: 34px;
                            text: "Watcher 중지";
                            enabled: AppState.live-loaded && !AppState.live-busy && AppState.live-running;
                            clicked => { AppState.live-stop(); }
                        }
                        Button {
                            height: 34px;
                            text: "새로고침";
                            enabled: AppState.live-loaded && !AppState.live-busy;
                            clicked => { AppState.live-refresh(); }
                        }
                    }
                    Text { text: AppState.live-message; color: #334155; wrap: word-wrap; font-size: 12px; }
                    Text {
                        text: "엔진: " + AppState.live-engine + "  ·  시작: " + AppState.live-started-at;
                        color: #64748b;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        height: 74px;
                        vertical-stretch: 0;
                        spacing: 8px;
                        LiveMetric { label: "채널"; value: AppState.live-channel-count; }
                        LiveMetric { label: "녹화 중"; value: AppState.live-recording-count; }
                        LiveMetric { label: "오프라인"; value: AppState.live-offline-count; }
                        LiveMetric { label: "오류"; value: AppState.live-error-count; }
                    }

                    if AppState.live-password-target != "": Rectangle {
                        height: 108px;
                        vertical-stretch: 0;
                        background: #fff7ed;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #fdba74;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 6px;
                            Text { text: "보호된 방송 · " + AppState.live-password-label; color: #9a3412; font-weight: 700; }
                            HorizontalLayout {
                                height: 34px;
                                vertical-stretch: 0;
                                spacing: 8px;
                                LineEdit {
                                    height: 34px;
                                    text <=> AppState.live-password-draft;
                                    input-type: password;
                                    enabled: !AppState.live-busy;
                                }
                                Button {
                                    height: 34px;
                                    text: "비밀번호 입력";
                                    enabled: !AppState.live-busy && AppState.live-password-draft != "";
                                    clicked => { AppState.live-password-submit(AppState.live-password-target, AppState.live-password-draft); }
                                }
                                Button {
                                    height: 34px;
                                    text: "취소";
                                    enabled: !AppState.live-busy;
                                    clicked => {
                                        AppState.live-password-target = "";
                                        AppState.live-password-label = "";
                                        AppState.live-password-draft = "";
                                    }
                                }
                            }
                            Text { text: "비밀번호는 메모리에만 유지되며 설정이나 SQLite에 저장되지 않습니다."; color: #9a3412; font-size: 11px; }
                        }
                    }

                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding: 2px;
                            spacing: 10px;
                            if AppState.live-rows.length == 0: Rectangle {
                                height: 82px;
                                vertical-stretch: 0;
                                background: #ffffff;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: #e2e8f0;
                                VerticalLayout {
                                    padding: 16px;
                                    Text { text: "현재 LIVE 런타임에 등록된 채널이 없습니다. 채널 탭에서 채널을 추가하세요."; color: #64748b; }
                                }
                            }
                            for row in AppState.live-rows: Rectangle {
                                height: (row.suppressed || row.detail != "") ? 178px : 156px;
                                vertical-stretch: 0;
                                background: #ffffff;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: row.status-tone == "error" ? #fecaca : row.status-tone == "warn" ? #fde68a : row.status-tone == "ok" ? #bbf7d0 : #e2e8f0;

                                HorizontalLayout {
                                    padding: 14px;
                                    spacing: 12px;

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 5px;

                                        Text {
                                            height: 24px;
                                            vertical-stretch: 0;
                                            text: row.platform + " · " + (row.name != "" ? row.name : row.account);
                                            color: #0f172a;
                                            font-size: 16px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                        Text { text: row.account; color: #64748b; font-size: 11px; }
                                        if row.title != "": Text { text: row.title; color: #334155; wrap: word-wrap; }
                                        if row.bno != "": Text { text: "방송: " + row.bno; color: #64748b; font-size: 11px; }
                                        if row.file != "": Text { text: "파일: " + row.file; color: #475569; wrap: word-wrap; font-size: 11px; }
                                        if row.size != "" || row.started-at != "": Text {
                                            text: (row.size != "" ? "크기: " + row.size : "") + (row.started-at != "" ? "  ·  시작: " + row.started-at : "");
                                            color: #64748b;
                                            font-size: 11px;
                                        }
                                        if row.suppressed: Text {
                                            text: "현재 방송은 방송이 바뀌거나 모니터링을 재개할 때까지 제외됩니다.";
                                            color: #a16207;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }
                                        if row.detail != "": Text {
                                            text: row.detail;
                                            color: row.status-tone == "error" ? #b91c1c : #64748b;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }
                                    }

                                    VerticalLayout {
                                        width: 300px;
                                        horizontal-stretch: 0;
                                        spacing: 8px;

                                        Text {
                                            height: 24px;
                                            vertical-stretch: 0;
                                            text: row.status-label;
                                            color: row.status-tone == "error" ? #b91c1c : row.status-tone == "warn" ? #a16207 : row.status-tone == "ok" ? #15803d : #64748b;
                                            font-weight: 700;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                        }

                                        Rectangle {
                                            vertical-stretch: 1;
                                            background: transparent;
                                        }

                                        HorizontalLayout {
                                            height: 32px;
                                            vertical-stretch: 0;
                                            spacing: 8px;

                                            Rectangle {
                                                horizontal-stretch: 1;
                                                background: transparent;
                                            }

                                            if row.can-stop-once: Button {
                                                width: 138px;
                                                height: 32px;
                                                horizontal-stretch: 0;
                                                text: "현재 방송 녹화 중지";
                                                enabled: !AppState.live-busy;
                                                clicked => { AppState.live-action(row.target, "stop"); }
                                            }
                                            if row.can-resume: Button {
                                                width: 126px;
                                                height: 32px;
                                                horizontal-stretch: 0;
                                                text: "모니터링 재개";
                                                enabled: !AppState.live-busy;
                                                clicked => { AppState.live-action(row.target, "resume"); }
                                            }
                                            if row.can-recheck: Button {
                                                width: 72px;
                                                height: 32px;
                                                horizontal-stretch: 0;
                                                text: "다시 확인";
                                                enabled: !AppState.live-busy;
                                                clicked => { AppState.live-action(row.target, "recheck"); }
                                            }
                                            if row.password-required: Button {
                                                width: 146px;
                                                height: 32px;
                                                horizontal-stretch: 0;
                                                text: "방송 비밀번호 입력";
                                                enabled: !AppState.live-busy;
                                                clicked => {
                                                    AppState.live-password-target = row.target;
                                                    AppState.live-password-label = row.platform + " · " + (row.name != "" ? row.name : row.account);
                                                    AppState.live-password-draft = "";
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if AppState.active-page == "Channels": VerticalLayout {
                    spacing: 9px;
                    HorizontalLayout {
                        height: 36px;
                        vertical-stretch: 0;
                        spacing: 8px;
                        Text {
                            text: "LIVE 채널 설정";
                            color: #0f172a;
                            font-size: 18px;
                            font-weight: 700;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Button {
                            height: 34px;
                            text: "+ 채널 추가";
                            enabled: AppState.config-loaded && !AppState.config-busy;
                            clicked => { AppState.channel-add(); }
                        }
                        Button {
                            height: 34px;
                            text: AppState.channels-dirty ? "채널 저장 *" : "채널 저장";
                            enabled: AppState.config-loaded && !AppState.config-busy && AppState.channels-dirty;
                            clicked => { AppState.save-channels(); }
                        }
                        Button {
                            height: 34px;
                            text: "저장값 다시 불러오기";
                            enabled: AppState.config-loaded && !AppState.config-busy;
                            clicked => { AppState.reload-configuration(); }
                        }
                    }
                    Rectangle {
                        min-height: 58px;
                        vertical-stretch: 0;
                        background: #ffffff;
                        border-radius: 9px;
                        border-width: 1px;
                        border-color: #e2e8f0;
                        VerticalLayout {
                            padding: 11px;
                            spacing: 3px;
                            Text { text: AppState.config-message; color: #334155; wrap: word-wrap; font-size: 12px; }
                            Text {
                                text: "SOOP은 계정 ID, CHZZK는 canonical channel ID를 사용합니다. 이름 조회를 누르면 공급자에서 표시 이름을 가져옵니다.";
                                color: #64748b;
                                wrap: word-wrap;
                                font-size: 11px;
                            }
                        }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding: 2px;
                            spacing: 7px;
                            if AppState.channel-config-rows.length == 0: Rectangle {
                                height: 88px;
                                vertical-stretch: 0;
                                background: #ffffff;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: #e2e8f0;
                                VerticalLayout {
                                    padding: 16px;
                                    Text { text: "설정된 채널이 없습니다. 채널을 추가하면 canonical SQLite에 첫 항목이 생성됩니다."; color: #64748b; wrap: word-wrap; }
                                }
                            }
                            for row[index] in AppState.channel-config-rows: Rectangle {
                                height: 68px;
                                vertical-stretch: 0;
                                background: #ffffff;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: #e2e8f0;

                                VerticalLayout {
                                    padding: 8px;

                                    HorizontalLayout {
                                        height: 50px;
                                        vertical-stretch: 0;
                                        spacing: 8px;

                                        VerticalLayout {
                                            width: 66px;
                                            horizontal-stretch: 0;
                                            spacing: 3px;

                                            Text {
                                                text: "플랫폼";
                                                color: #64748b;
                                                font-size: 10px;
                                            }

                                            Button {
                                                height: 30px;
                                                text: row.platform;
                                                enabled: !AppState.config-busy;
                                                clicked => { AppState.channel-toggle-platform(index); }
                                            }
                                        }

                                        VerticalLayout {
                                            width: 80px;
                                            horizontal-stretch: 0;
                                            spacing: 3px;

                                            Text {
                                                text: "상태";
                                                color: #64748b;
                                                font-size: 10px;
                                            }

                                            Button {
                                                height: 30px;
                                                text: row.enabled ? "사용" : "사용 안 함";
                                                enabled: !AppState.config-busy;
                                                clicked => { AppState.channel-toggle-enabled(index); }
                                            }
                                        }

                                        VerticalLayout {
                                            width: 140px;
                                            horizontal-stretch: 0;
                                            spacing: 3px;

                                            Text {
                                                text: "이름";
                                                color: #64748b;
                                                font-size: 10px;
                                            }

                                            LineEdit {
                                                height: 30px;
                                                text <=> row.name;
                                                enabled: !AppState.config-busy;
                                                edited(value) => { AppState.channel-edited(index, "name", value); }
                                            }
                                        }

                                        VerticalLayout {
                                            width: 170px;
                                            horizontal-stretch: 0;
                                            spacing: 3px;

                                            Text {
                                                text: "계정 / 채널 ID";
                                                color: #64748b;
                                                font-size: 10px;
                                            }

                                            LineEdit {
                                                height: 30px;
                                                text <=> row.account;
                                                enabled: !AppState.config-busy;
                                                edited(value) => { AppState.channel-edited(index, "account", value); }
                                                accepted => { AppState.channel-resolve(index); }
                                            }
                                        }

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 3px;

                                            Text {
                                                text: "저장 폴더";
                                                color: #64748b;
                                                font-size: 10px;
                                            }

                                            LineEdit {
                                                height: 30px;
                                                horizontal-stretch: 1;
                                                text <=> row.outdir;
                                                placeholder-text: "비워두면 런타임 기본값 사용";
                                                enabled: !AppState.config-busy;
                                                edited(value) => { AppState.channel-edited(index, "outdir", value); }
                                            }
                                        }

                                        VerticalLayout {
                                            width: 72px;
                                            horizontal-stretch: 0;
                                            spacing: 3px;

                                            Rectangle {
                                                height: 12px;
                                                vertical-stretch: 0;
                                                background: transparent;
                                            }

                                            Button {
                                                height: 30px;
                                                text: "이름 조회";
                                                enabled: !AppState.config-busy && row.account != "";
                                                clicked => { AppState.channel-resolve(index); }
                                            }
                                        }

                                        VerticalLayout {
                                            width: 68px;
                                            horizontal-stretch: 0;
                                            spacing: 3px;

                                            Rectangle {
                                                height: 12px;
                                                vertical-stretch: 0;
                                                background: transparent;
                                            }

                                            Button {
                                                height: 30px;
                                                text: "삭제";
                                                enabled: !AppState.config-busy;
                                                clicked => { AppState.channel-remove(index); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if AppState.active-page == "VOD": VerticalLayout {
                    spacing: 9px;
                    HorizontalLayout {
                        height: 36px;
                        vertical-stretch: 0;
                        spacing: 8px;
                        Text {
                            text: "VOD 분석 및 다운로드";
                            color: #0f172a;
                            font-size: 18px;
                            font-weight: 700;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Button {
                            height: 34px;
                            text: "분석";
                            enabled: AppState.vod-loaded && AppState.vod-can-analyze && !AppState.vod-busy && !AppState.vod-running;
                            clicked => { AppState.vod-analyze(); }
                        }
                        Button {
                            height: 34px;
                            text: "새로고침";
                            enabled: AppState.vod-loaded && !AppState.vod-busy;
                            clicked => { AppState.vod-refresh(); }
                        }
                        Button {
                            height: 34px;
                            text: "취소";
                            enabled: AppState.vod-loaded && AppState.vod-running && !AppState.vod-busy;
                            clicked => { AppState.vod-cancel(); }
                        }
                    }
                    Rectangle {
                        min-height: 72px;
                        vertical-stretch: 0;
                        background: #ffffff;
                        border-radius: 9px;
                        border-width: 1px;
                        border-color: #e2e8f0;
                        VerticalLayout {
                            padding: 11px;
                            spacing: 5px;
                            LineEdit {
                                height: 34px;
                                vertical-stretch: 0;
                                text <=> AppState.vod-url;
                                enabled: !AppState.vod-busy && !AppState.vod-running;
                                placeholder-text: "SOOP or CHZZK VOD URL";
                                edited(value) => { AppState.vod-url-edited(value); }
                                accepted => { AppState.vod-analyze(); }
                            }
                            Text { text: AppState.vod-message; color: #334155; font-size: 12px; wrap: word-wrap; }
                        }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding: 2px;
                            spacing: 10px;
                            Rectangle {
                                height: 108px;
                                vertical-stretch: 0;
                                background: #ffffff;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: AppState.vod-state-tone == "error" ? #fecaca : AppState.vod-state-tone == "warn" ? #fde68a : AppState.vod-state-tone == "ok" ? #bbf7d0 : #e2e8f0;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 5px;
                                    HorizontalLayout {
                                        height: 24px;
                                        vertical-stretch: 0;
                                        spacing: 8px;
                                        Text {
                                            text: AppState.vod-platform + " · " + AppState.vod-state;
                                            color: AppState.vod-state-tone == "error" ? #b91c1c : AppState.vod-state-tone == "warn" ? #a16207 : AppState.vod-state-tone == "ok" ? #15803d : #334155;
                                            font-size: 16px;
                                            font-weight: 700;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                        }
                                        Text { text: AppState.vod-current-part + " / " + AppState.vod-part-count + "개 PART"; color: #64748b; font-size: 11px; vertical-alignment: center; }
                                        Text { text: AppState.vod-percent-label; color: #0f172a; font-weight: 700; vertical-alignment: center; }
                                    }
                                    Rectangle {
                                        height: 8px;
                                        vertical-stretch: 0;
                                        background: #e2e8f0;
                                        border-radius: 4px;
                                        Rectangle {
                                            x: 0px;
                                            y: 0px;
                                            height: parent.height;
                                            width: parent.width * AppState.vod-percent / 100;
                                            background: #334155;
                                            border-radius: 4px;
                                        }
                                    }
                                    Text { text: AppState.vod-runtime-message; color: #475569; font-size: 11px; wrap: word-wrap; }
                                    Text {
                                        text: "시작: " + AppState.vod-started-at + "  ·  완료: " + AppState.vod-finished-at;
                                        color: #94a3b8;
                                        font-size: 11px;
                                        wrap: word-wrap;
                                    }
                                    if AppState.vod-output-file != "": Text { text: "출력: " + AppState.vod-output-file; color: #475569; font-size: 11px; wrap: word-wrap; }
                                }
                            }

                            if AppState.vod-title != "" || AppState.vod-streamer != "": Rectangle {
                                height: 82px;
                                vertical-stretch: 0;
                                background: #ffffff;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: #e2e8f0;
                                VerticalLayout {
                                    padding: 11px;
                                    spacing: 4px;
                                    Text { text: AppState.vod-title != "" ? AppState.vod-title : "VOD metadata"; color: #0f172a; font-size: 15px; font-weight: 700; wrap: word-wrap; }
                                    Text { text: "스트리머: " + AppState.vod-streamer + (AppState.vod-streamer-id != "" ? "  ·  " + AppState.vod-streamer-id : ""); color: #64748b; font-size: 11px; wrap: word-wrap; }
                                    Text { text: "PART 수: " + AppState.vod-part-count; color: #64748b; font-size: 11px; }
                                }
                            }

                            HorizontalLayout {
                                min-height: 166px;
                                vertical-stretch: 0;
                                spacing: 10px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: #ffffff;
                                    border-radius: 10px;
                                    border-width: 1px;
                                    border-color: #e2e8f0;
                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 6px;
                                        Text { text: "화질"; color: #0f172a; font-size: 14px; font-weight: 700; }
                                        ScrollView {
                                            vertical-stretch: 1;
                                            VerticalLayout {
                                                spacing: 5px;
                                                if AppState.vod-quality-rows.length == 0: Text { text: "VOD를 분석하면 화질 목록이 표시됩니다."; color: #94a3b8; font-size: 11px; wrap: word-wrap; }
                                                for row[index] in AppState.vod-quality-rows: Button {
                                                    height: 30px;
                                                    text: (row.selected ? "✓ " : "") + row.label;
                                                    enabled: !AppState.vod-busy && !AppState.vod-running;
                                                    clicked => { AppState.vod-select-quality(index); }
                                                }
                                            }
                                        }
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: #ffffff;
                                    border-radius: 10px;
                                    border-width: 1px;
                                    border-color: #e2e8f0;
                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 6px;
                                        HorizontalLayout {
                                            height: 30px;
                                            vertical-stretch: 0;
                                            spacing: 6px;
                                            Text { text: "PART"; color: #0f172a; font-size: 14px; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
                                            Button {
                                                height: 28px;
                                                text: "전체 선택";
                                                enabled: AppState.vod-part-rows.length > 0 && !AppState.vod-busy && !AppState.vod-running;
                                                clicked => { AppState.vod-select-all-parts(); }
                                            }
                                            Button {
                                                height: 28px;
                                                text: "선택 해제";
                                                enabled: AppState.vod-part-rows.length > 0 && !AppState.vod-busy && !AppState.vod-running;
                                                clicked => { AppState.vod-clear-parts(); }
                                            }
                                        }
                                        ScrollView {
                                            vertical-stretch: 1;
                                            VerticalLayout {
                                                spacing: 5px;
                                                if AppState.vod-part-rows.length == 0: Text { text: "VOD를 분석하면 PART 목록이 표시됩니다."; color: #94a3b8; font-size: 11px; wrap: word-wrap; }
                                                for row[index] in AppState.vod-part-rows: Button {
                                                    height: 30px;
                                                    text: (row.selected ? "✓ " : "") + "Part " + row.part + "  ·  " + row.duration;
                                                    enabled: !AppState.vod-busy && !AppState.vod-running;
                                                    clicked => { AppState.vod-toggle-part(index); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                height: 100px;
                                vertical-stretch: 0;
                                background: #ffffff;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: #e2e8f0;
                                VerticalLayout {
                                    padding: 11px;
                                    spacing: 6px;
                                    HorizontalLayout {
                                        height: 34px;
                                        vertical-stretch: 0;
                                        spacing: 8px;
                                        Text { text: "다운로드"; color: #0f172a; font-size: 15px; font-weight: 700; vertical-alignment: center; }
                                        LineEdit {
                                            height: 34px;
                                            vertical-stretch: 0;
                                            horizontal-stretch: 1;
                                            text <=> AppState.vod-output-directory;
                                            enabled: !AppState.vod-busy && !AppState.vod-running;
                                            placeholder-text: "저장 폴더";
                                            edited(value) => { AppState.vod-output-edited(value); }
                                        }
                                        Button {
                                            height: 32px;
                                            text: "찾아보기...";
                                            enabled: !AppState.vod-busy && !AppState.vod-running;
                                            clicked => { AppState.vod-pick-output(); }
                                        }
                                        Button {
                                            height: 32px;
                                            text: AppState.vod-merge ? "병합: 켜짐" : "병합: 꺼짐";
                                            enabled: !AppState.vod-busy && !AppState.vod-running;
                                            clicked => { AppState.vod-toggle-merge(); }
                                        }
                                                  Button {
                                            height: 32px;
                                            text: "다운로드";
                                            enabled: AppState.vod-loaded && AppState.vod-can-download && !AppState.vod-busy && !AppState.vod-running;
                                            clicked => { AppState.vod-download(); }
                                        }
                                                  Button {
                                            height: 32px;
                                            text: "대기열에 추가";
                                            enabled: AppState.vod-loaded && AppState.vod-can-download && !AppState.vod-busy && !AppState.vod-running;
                                            clicked => { QueueHistoryLocal.enqueue-current(); }
                                        }

                                    }
                                    Text { text: "도구 경로와 공급자 인증 정보는 canonical 설정을 사용합니다."; color: #64748b; font-size: 11px; wrap: word-wrap; }
                                }
                            }
                        }
                    }
                }
                          if AppState.active-page == "Queue": QueuePage { vertical-stretch: 1; }
                if AppState.active-page == "History": HistoryPage { vertical-stretch: 1; }
                if AppState.active-page == "Maintenance": MaintenancePage { vertical-stretch: 1; }


                if AppState.active-page == "Settings": VerticalLayout {
                    spacing: 9px;
                    Text { text: "설정 편집 · 공유 SQLite"; color: #0f172a; font-size: 18px; font-weight: 700; }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding: 3px;
                            spacing: 12px;

                            Rectangle {
                                min-height: 330px;
                                vertical-stretch: 0;
                                background: #ffffff;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: #e2e8f0;
                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 8px;
                                    Text { text: "공급자 인증 정보"; color: #0f172a; font-size: 18px; font-weight: 700; }
                                    Text { text: AppState.config-message; color: #334155; wrap: word-wrap; font-size: 12px; }
                                    HorizontalLayout {
                                        height: 34px;
                                        vertical-stretch: 0;
                                        spacing: 8px;
                                        Button {
                                            height: 32px;
                                            text: "공급자 설정 저장";
                                            enabled: AppState.config-loaded && !AppState.config-busy;
                                            clicked => { AppState.save-provider(); }
                                        }
                                        Button {
                                            height: 32px;
                                            text: "SOOP + Worker 테스트";
                                            enabled: AppState.config-loaded && !AppState.config-busy
                                                && AppState.soop-username != ""
                                                && AppState.cloudflare-worker-url != ""
                                                && AppState.soop-password-configured
                                                && AppState.cloudflare-key-configured;
                                            clicked => { AppState.test-soop-auth(); }
                                        }
                                        Button {
                                            height: 32px;
                                            text: "저장값 다시 불러오기";
                                            enabled: AppState.config-loaded && !AppState.config-busy;
                                            clicked => { AppState.reload-configuration(); }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }
                                    HorizontalLayout {
                                        height: 58px;
                                        vertical-stretch: 0;
                                        spacing: 10px;
                                        VerticalLayout {
                                            spacing: 4px;
                                            Text { text: "SOOP 사용자명"; color: #0f172a; font-weight: 600; font-size: 12px; }
                                            LineEdit { height: 34px; text <=> AppState.soop-username; enabled: !AppState.config-busy; }
                                        }
                                        VerticalLayout {
                                            spacing: 4px;
                                            Text { text: "Cloudflare Worker URL"; color: #0f172a; font-weight: 600; font-size: 12px; }
                                            LineEdit { height: 34px; text <=> AppState.cloudflare-worker-url; enabled: !AppState.config-busy; }
                                        }
                                    }
                                    HorizontalLayout {
                                        height: 58px;
                                        vertical-stretch: 0;
                                        spacing: 10px;
                                        VerticalLayout {
                                            spacing: 4px;
                                            Text { text: "SOOP 비밀번호 · " + (AppState.soop-password-configured ? "설정됨" : "미설정"); color: AppState.soop-password-configured ? #15803d : #a16207; font-size: 11px; }
                                            LineEdit { height: 34px; text <=> AppState.soop-password-draft; input-type: password; enabled: !AppState.config-busy; }
                                        }
                                        VerticalLayout {
                                            spacing: 4px;
                                            Text { text: "Worker API key · " + (AppState.cloudflare-key-configured ? "설정됨" : "미설정"); color: AppState.cloudflare-key-configured ? #15803d : #a16207; font-size: 11px; }
                                            LineEdit { height: 34px; text <=> AppState.cloudflare-key-draft; input-type: password; enabled: !AppState.config-busy; }
                                        }
                                    }
                                    HorizontalLayout {
                                        height: 58px;
                                        vertical-stretch: 0;
                                        spacing: 10px;
                                        VerticalLayout {
                                            spacing: 4px;
                                            Text { text: "CHZZK NID_AUT · " + (AppState.chzzk-nid-aut-configured ? "설정됨" : "미설정"); color: AppState.chzzk-nid-aut-configured ? #15803d : #a16207; font-size: 11px; }
                                            LineEdit { height: 34px; text <=> AppState.chzzk-nid-aut-draft; input-type: password; enabled: !AppState.config-busy; }
                                        }
                                        VerticalLayout {
                                            spacing: 4px;
                                            Text { text: "CHZZK NID_SES · " + (AppState.chzzk-nid-ses-configured ? "설정됨" : "미설정"); color: AppState.chzzk-nid-ses-configured ? #15803d : #a16207; font-size: 11px; }
                                            LineEdit { height: 34px; text <=> AppState.chzzk-nid-ses-draft; input-type: password; enabled: !AppState.config-busy; }
                                        }
                                    }
                                    Text {
                                        text: "Blank secret fields keep the saved value. Secrets remain protected by the platform secret store and are never read back into the UI.";
                                        color: #64748b;
                                        wrap: word-wrap;
                                        font-size: 11px;
                                    }
                                }
                            }

                            Rectangle {
                                min-height: 72px;
                                vertical-stretch: 0;
                                background: #ffffff;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: #e2e8f0;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 6px;
                                    HorizontalLayout {
                                        height: 32px;
                                        vertical-stretch: 0;
                                        spacing: 8px;
                                        Text { text: "런타임 환경"; color: #0f172a; font-size: 17px; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
                                        Button {
                                            height: 30px;
                                            text: AppState.settings-dirty ? "변경사항 저장 *" : "변경사항 저장";
                                            enabled: AppState.settings-loaded && !AppState.settings-busy && AppState.settings-dirty;
                                            clicked => { AppState.save-settings(); }
                                        }
                                        Button {
                                            height: 30px;
                                            text: "저장값 다시 불러오기";
                                            enabled: AppState.settings-loaded && !AppState.settings-busy;
                                            clicked => { AppState.reload-settings(); }
                                        }
                                    }
                                    Text { text: AppState.settings-message; wrap: word-wrap; color: #64748b; font-size: 11px; }
                                }
                            }

                            for row[index] in AppState.settings-rows: Rectangle {
                                min-height: 82px;
                                vertical-stretch: 0;
                                background: #ffffff;
                                border-radius: 9px;
                                border-width: 1px;
                                border-color: #e2e8f0;
                                VerticalLayout {
                                    padding: 11px;
                                    spacing: 5px;
                                    Text { text: row.key; color: #0f172a; font-weight: 600; font-size: 12px; }
                                    HorizontalLayout {
                                        height: 34px;
                                        vertical-stretch: 0;
                                        spacing: 8px;
                                        LineEdit {
                                            height: 34px;
                                            text <=> row.value;
                                            enabled: !AppState.settings-busy;
                                            edited(value) => { AppState.setting-edited(index, value); }
                                        }
                                        if row.pickable: Button {
                                            width: 78px;
                                            height: 32px;
                                            text: "찾아보기...";
                                            enabled: !AppState.settings-busy;
                                            clicked => { AppState.pick-setting(index); }
                                        }
                                    }
                                    Text { text: row.description; color: #64748b; wrap: word-wrap; font-size: 11px; }
                                }
                            }

                            Text { text: "진단 · 읽기 전용"; color: #0f172a; font-size: 18px; font-weight: 700; }
                            Text { text: "백엔드와 DB 위치는 시작 시 관리됩니다. 별도 설정 파일은 사용하지 않습니다."; color: #64748b; wrap: word-wrap; font-size: 11px; }
                            for row in AppState.diagnostics-rows: Rectangle {
                                min-height: 56px;
                                vertical-stretch: 0;
                                background: #ffffff;
                                border-radius: 9px;
                                border-width: 1px;
                                border-color: #e2e8f0;
                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 3px;
                                    Text {
                                        text: row.status + " · " + row.name;
                                        color: row.status == "OK" ? #15803d : row.status == "Warning" ? #a16207 : #b91c1c;
                                        font-weight: 600;
                                        font-size: 12px;
                                    }
                                    Text { text: row.detail; color: #475569; wrap: word-wrap; font-size: 11px; }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
