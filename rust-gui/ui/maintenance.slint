import { Button, LineEdit, ScrollView } from "std-widgets.slint";

export struct MaintenanceBackupRow {
    file-name: string,
    kind: string,
    created-at: string,
    size: string,
    sha256: string,
    integrity: string,
    integrity-tone: string,
    can-restore: bool,
}

export struct MaintenanceDiagnosticRow {
    category: string,
    requirement: string,
    name: string,
    status: string,
    summary: string,
    detail: string,
    remediation: string,
    status-tone: string,
}

export struct MaintenanceLogRow {
    text: string,
}

export global MaintenanceState {
    in-out property <bool> busy: true;
    in-out property <bool> loaded: false;
    in-out property <string> message: "관리 상태를 불러오는 중...";
    in-out property <string> section: "Backup";

    in-out property <string> backup-directory: "";
    in-out property <bool> backup-directory-editable: false;
    in-out property <bool> backup-enabled: true;
    in-out property <string> backup-interval-hours: "24";
    in-out property <string> backup-keep-count: "10";
    in-out property <string> backup-retention-days: "3";
    in-out property <[MaintenanceBackupRow]> backup-rows;
    in-out property <string> restore-pending-file: "";

    in-out property <[MaintenanceDiagnosticRow]> diagnostic-rows;
    in-out property <bool> diagnostic-runtime-ready: false;
    in-out property <string> diagnostic-summary: "";

    in-out property <[MaintenanceLogRow]> log-rows;
    in-out property <bool> log-auto-refresh: true;
    in-out property <string> log-message: "런타임 로그는 최근 200줄까지만 표시됩니다.";

    callback refresh();
    callback pick-backup-directory();
    callback toggle-backup-enabled();
    callback save-backup-policy();
    callback create-backup();
    callback request-restore(string);
    callback confirm-restore();
    callback cancel-restore();
    callback refresh-logs();
    callback toggle-log-auto-refresh();
}

component SectionButton inherits Button {
    in property <string> section-name;
    text: root.section-name == "Backup" ? "백업 / 복원" : root.section-name == "Diagnostics" ? "진단" : "로그";
    clicked => { MaintenanceState.section = root.section-name; }
}

component SummaryLabel inherits Text {
    color: #64748b;
    font-size: 11px;
    wrap: word-wrap;
}

export component MaintenancePage inherits VerticalLayout {
    spacing: 10px;

    HorizontalLayout {
        height: 36px;
        vertical-stretch: 0;
        spacing: 8px;
        Text {
            text: "백업 / 복원 / 진단 / 로그";
            color: #0f172a;
            font-size: 18px;
            font-weight: 700;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
        SectionButton { height: 34px; section-name: "Backup"; enabled: !MaintenanceState.busy; }
        SectionButton { height: 34px; section-name: "Diagnostics"; enabled: !MaintenanceState.busy; }
        SectionButton { height: 34px; section-name: "Logs"; enabled: !MaintenanceState.busy; }
        Button {
            height: 34px;
            text: "새로고침";
            enabled: MaintenanceState.loaded && !MaintenanceState.busy;
            clicked => { MaintenanceState.refresh(); }
        }
    }

    Text {
        text: MaintenanceState.message;
        color: #475569;
        font-size: 12px;
        wrap: word-wrap;
        vertical-stretch: 0;
    }

    if MaintenanceState.section == "Backup": VerticalLayout {
        spacing: 10px;

        // Phase 21.9: Settings > Manage owns backup policy and operations.
        Rectangle {
            min-height: 188px;
            vertical-stretch: 0;
            background: #ffffff;
            border-radius: 10px;
            border-width: 1px;
            border-color: #e2e8f0;
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                HorizontalLayout {
                    height: 28px;
                    vertical-stretch: 0;
                    Text {
                        text: "백업 정책";
                        color: #0f172a;
                        font-size: 17px;
                        font-weight: 700;
                        horizontal-stretch: 1;
                    }
                    Button {
                        height: 28px;
                        text: "정책 저장";
                        enabled: MaintenanceState.loaded && !MaintenanceState.busy;
                        clicked => { MaintenanceState.save-backup-policy(); }
                    }
                }
                Text {
                    text: "자동 백업의 위치와 보존 정책을 설정합니다. 아래에서 즉시 백업 생성과 복원도 함께 관리합니다.";
                    color: #64748b;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    height: 34px;
                    vertical-stretch: 0;
                    spacing: 8px;
                    LineEdit {
                        height: 34px;
                        horizontal-stretch: 1;
                        text <=> MaintenanceState.backup-directory;
                        enabled: !MaintenanceState.busy && MaintenanceState.backup-directory-editable;
                        placeholder-text: "백업 폴더";
                    }
                    Button {
                        width: 84px;
                        height: 32px;
                        text: "찾아보기...";
                        enabled: !MaintenanceState.busy && MaintenanceState.backup-directory-editable;
                        clicked => { MaintenanceState.pick-backup-directory(); }
                    }
                }
                if !MaintenanceState.backup-directory-editable: Text {
                    text: "STREAM_ARCHIVE_BACKUP_DIR에서 관리되는 경로이므로 읽기 전용입니다.";
                    color: #a16207;
                    font-size: 10px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    height: 48px;
                    vertical-stretch: 0;
                    spacing: 10px;
                    VerticalLayout {
                        width: 126px;
                        horizontal-stretch: 0;
                        spacing: 2px;
                        Text { text: "자동 백업"; color: #64748b; font-size: 10px; }
                        Button {
                            height: 30px;
                            text: MaintenanceState.backup-enabled ? "켜짐" : "꺼짐";
                            enabled: !MaintenanceState.busy;
                            clicked => { MaintenanceState.toggle-backup-enabled(); }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text { text: "백업 주기(시간)"; color: #64748b; font-size: 10px; }
                        LineEdit {
                            height: 30px;
                            text <=> MaintenanceState.backup-interval-hours;
                            enabled: !MaintenanceState.busy;
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text { text: "최대 백업 개수 · 0 = 제한 없음"; color: #64748b; font-size: 10px; }
                        LineEdit {
                            height: 30px;
                            text <=> MaintenanceState.backup-keep-count;
                            enabled: !MaintenanceState.busy;
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text { text: "보관 기간(일) · 0 = 제한 없음"; color: #64748b; font-size: 10px; }
                        LineEdit {
                            height: 30px;
                            text <=> MaintenanceState.backup-retention-days;
                            enabled: !MaintenanceState.busy;
                        }
                    }
                }
            }
        }

        Rectangle {
            min-height: 92px;
            vertical-stretch: 0;
            background: #ffffff;
            border-radius: 10px;
            border-width: 1px;
            border-color: #e2e8f0;
            VerticalLayout {
                padding: 12px;
                spacing: 7px;
                HorizontalLayout {
                    height: 32px;
                    vertical-stretch: 0;
                    spacing: 8px;
                    Text {
                        text: "백업 / 복원";
                        color: #0f172a;
                        font-size: 14px;
                        font-weight: 700;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    Button {
                        height: 32px;
                        text: "지금 백업 생성";
                        enabled: MaintenanceState.loaded && !MaintenanceState.busy;
                        clicked => { MaintenanceState.create-backup(); }
                    }
                }
                SummaryLabel {
                    text: "백업 위치: " + (MaintenanceState.backup-directory != "" ? MaintenanceState.backup-directory : "-");
                }
                SummaryLabel {
                    text: "현재 정책으로 수동 백업을 생성하고, 무결성 확인과 복원을 수행합니다.";
                }
            }
        }

        if MaintenanceState.restore-pending-file != "": Rectangle {
            min-height: 108px;
            vertical-stretch: 0;
            background: #fff7ed;
            border-radius: 10px;
            border-width: 1px;
            border-color: #fdba74;
            VerticalLayout {
                padding: 12px;
                spacing: 6px;
                Text {
                    text: MaintenanceState.restore-pending-file + " 파일을 복원할까요?";
                    color: #9a3412;
                    font-size: 14px;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                SummaryLabel {
                    text: "canonical SQLite DB를 이 백업으로 복원합니다. 먼저 pre_restore 안전 백업을 생성하며, Watcher·VOD·Queue 작업이 모두 유휴 상태여야 합니다.";
                    color: #9a3412;
                }
                HorizontalLayout {
                    height: 32px;
                    vertical-stretch: 0;
                    spacing: 8px;
                    Button {
                        height: 32px;
                        text: "복원 확인";
                        enabled: !MaintenanceState.busy;
                        clicked => { MaintenanceState.confirm-restore(); }
                    }
                    Button {
                        height: 32px;
                        text: "취소";
                        enabled: !MaintenanceState.busy;
                        clicked => { MaintenanceState.cancel-restore(); }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                }
            }
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 2px;
                spacing: 6px;
                alignment: start;

                if MaintenanceState.backup-rows.length == 0: Rectangle {
                    height: 78px;
                    vertical-stretch: 0;
                    background: #ffffff;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #e2e8f0;
                    VerticalLayout {
                        padding: 14px;
                        Text { text: "관리 중인 백업이 없습니다."; color: #64748b; }
                    }
                }

                for row in MaintenanceState.backup-rows: Rectangle {
                    min-height: 68px;
                    vertical-stretch: 0;
                    background: #ffffff;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: row.integrity-tone == "ok" ? #bbf7d0 : row.integrity-tone == "error" ? #fecaca : #fde68a;
                    VerticalLayout {
                        padding: 6px;
                        spacing: 2px;
                        HorizontalLayout {
                            min-height: 24px;
                            vertical-stretch: 0;
                            spacing: 8px;
                            Text {
                                text: row.file-name;
                                color: #0f172a;
                                font-size: 13px;
                                font-weight: 700;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }
                            Text {
                                text: row.integrity;
                                color: row.integrity-tone == "ok" ? #15803d : row.integrity-tone == "error" ? #b91c1c : #a16207;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            Button {
                                height: 24px;
                                text: "복원";
                                enabled: !MaintenanceState.busy && row.can-restore;
                                clicked => { MaintenanceState.request-restore(row.file-name); }
                            }
                        }
                        SummaryLabel {
                            vertical-stretch: 0;
                            vertical-alignment: center;
                            text: row.kind + "  ·  " + row.created-at + "  ·  " + row.size;
                        }
                        SummaryLabel {
                            vertical-stretch: 0;
                            vertical-alignment: center;
                            text: "SHA256: " + row.sha256;
                        }
                    }
                }
            }
        }
    }

    // Phase 23.2: Native Diagnostics renders the shared read-only runtime preflight.
    if MaintenanceState.section == "Diagnostics": ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            padding: 2px;
            spacing: 8px;
            alignment: start;
            Rectangle {
                min-height: 64px;
                vertical-stretch: 0;
                background: MaintenanceState.diagnostic-runtime-ready ? #f0fdf4 : #fff1f2;
                border-radius: 9px;
                border-width: 1px;
                border-color: MaintenanceState.diagnostic-runtime-ready ? #bbf7d0 : #fecaca;
                VerticalLayout {
                    padding: 11px;
                    spacing: 4px;
                    Text {
                        text: MaintenanceState.diagnostic-runtime-ready ? "런타임 사용 가능" : "차단 오류 확인 필요";
                        color: MaintenanceState.diagnostic-runtime-ready ? #15803d : #b91c1c;
                        font-weight: 700;
                        font-size: 13px;
                    }
                    SummaryLabel { text: MaintenanceState.diagnostic-summary; }
                }
            }
            Text {
                text: "진단은 로컬 읽기 전용 preflight입니다. 공급자 네트워크 접속, 실제 다운로드, 설정 변경은 수행하지 않습니다.";
                color: #64748b;
                font-size: 11px;
                wrap: word-wrap;
                vertical-stretch: 0;
            }
            for row in MaintenanceState.diagnostic-rows: Rectangle {
                min-height: 88px;
                vertical-stretch: 0;
                background: #ffffff;
                border-radius: 9px;
                border-width: 1px;
                border-color: row.status-tone == "ok" ? #bbf7d0 : row.status-tone == "error" ? #fecaca : #fde68a;
                VerticalLayout {
                    padding: 11px;
                    spacing: 4px;
                    HorizontalLayout {
                        min-height: 20px;
                        vertical-stretch: 0;
                        spacing: 8px;
                        Text {
                            text: row.category + " · " + row.name;
                            color: #0f172a;
                            font-weight: 700;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                        Text {
                            text: row.requirement + " · " + row.status;
                            color: row.status-tone == "error" ? #b91c1c : row.status-tone == "warn" ? #a16207 : #15803d;
                            font-weight: 700;
                        }
                    }
                    Text { text: row.summary; color: #334155; font-size: 11px; wrap: word-wrap; vertical-stretch: 0; }
                    if row.detail != "": SummaryLabel { text: row.detail; }
                    if row.remediation != "": Text {
                        text: "조치: " + row.remediation;
                        color: row.status-tone == "error" ? #b91c1c : #a16207;
                        font-size: 11px;
                        wrap: word-wrap;
                        vertical-stretch: 0;
                    }
                }
            }
        }
    }

    if MaintenanceState.section == "Logs": VerticalLayout {
        spacing: 8px;
        HorizontalLayout {
            height: 34px;
            vertical-stretch: 0;
            spacing: 8px;
            Button {
                height: 34px;
                text: MaintenanceState.log-auto-refresh ? "자동 새로고침: 켜짐" : "자동 새로고침: 꺼짐";
                enabled: !MaintenanceState.busy;
                clicked => { MaintenanceState.toggle-log-auto-refresh(); }
            }
            Button {
                height: 34px;
                text: "로그 새로고침";
                enabled: !MaintenanceState.busy;
                clicked => { MaintenanceState.refresh-logs(); }
            }
            Text {
                text: MaintenanceState.log-message;
                color: #64748b;
                font-size: 11px;
                horizontal-stretch: 1;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 2px;
                spacing: 4px;
                alignment: start;
                if MaintenanceState.log-rows.length == 0: Rectangle {
                    height: 70px;
                    vertical-stretch: 0;
                    background: #ffffff;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #e2e8f0;
                    Text {
                        x: 12px;
                        y: 12px;
                        width: parent.width - 24px;
                        text: "아직 런타임 로그가 없습니다.";
                        color: #64748b;
                    }
                }
                for row in MaintenanceState.log-rows: Rectangle {
                    min-height: 28px;
                    vertical-stretch: 0;
                    background: #ffffff;
                    border-radius: 5px;
                    border-width: 1px;
                    border-color: #e2e8f0;
                    VerticalLayout {
                        padding: 6px;
                        Text {
                            text: row.text;
                            color: #334155;
                            font-size: 10px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}
