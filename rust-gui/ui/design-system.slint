// Shared presentation tokens. No runtime or persistence logic belongs here.
export global Theme {
    out property <color> canvas: #171c22;
    out property <color> sidebar: #14191f;
    out property <color> surface: #20272f;
    out property <color> raised: #28323c;
    out property <color> border: #34404b;
    out property <color> text: #edf3f5;
    out property <color> secondary: #becad2;
    out property <color> muted: #aebbc5;
    out property <color> accent: #32d5bf;
    out property <color> accent-ink: #092822;
    out property <color> selected: #203b3c;
    out property <color> success: #71ddba;
    out property <color> warning: #f3c36b;
    out property <color> danger: #ff9caa;
    out property <color> success-surface: #203a32;
    out property <color> warning-surface: #393126;
    out property <color> danger-surface: #3c2830;
}

// Keep keyboard, focus and accessibility semantics for every styled action.
export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback clicked();
    min-width: max(32px, label.preferred-width + (root.icon.width > 0 ? 46px : 24px));
    min-height: 30px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 8px;
    border-width: 1px;
    border-color: focus.has-focus && root.enabled ? (root.primary ? Theme.text : Theme.accent) : root.danger ? Theme.danger-surface : Theme.border;
    background: !root.enabled ? Theme.surface : root.primary ? (touch.pressed ? #24af9d : touch.has-hover ? #58e2cf : Theme.accent) : root.selected ? Theme.selected : touch.has-hover ? Theme.raised : Theme.surface;
    opacity: root.enabled ? 1 : 0.5;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    if root.icon.width > 0: Image {
        x: 12px; y: (parent.height - 16px) / 2; width: 16px; height: 16px;
        source: root.icon; colorize: root.danger ? Theme.danger : root.primary ? Theme.accent-ink : Theme.secondary;
    }
    label := Text {
        x: root.icon.width > 0 ? 34px : 12px;
        width: parent.width - (root.icon.width > 0 ? 46px : 24px);
        height: parent.height;
        text: root.text;
        color: root.primary ? Theme.accent-ink : root.danger ? Theme.danger : root.selected ? Theme.accent : Theme.text;
        font-size: 13px;
        font-weight: root.primary ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { focus.focus(); root.clicked(); }
    }
    focus := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

export component StatusPill inherits Rectangle {
    in property <string> text;
    in property <string> tone;
    in property <bool> dot: false;
    in property <bool> boxed: false;
    height: root.boxed ? 34px : 26px;
    min-width: label.preferred-width + (root.dot ? 36px : 22px);
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: root.boxed ? 8px : 13px;
    background: root.tone == "error" ? Theme.danger-surface : root.tone == "warn" ? Theme.warning-surface : root.tone == "ok" ? Theme.success-surface : Theme.raised;
    if root.dot: Rectangle {
        x: 11px; y: (parent.height - 8px) / 2; width: 8px; height: 8px; border-radius: 4px;
        background: root.tone == "error" ? Theme.danger : root.tone == "warn" ? Theme.warning : root.tone == "ok" ? Theme.success : Theme.muted;
    }
    label := Text {
        x: root.dot ? 25px : 11px;
        width: parent.width - (root.dot ? 36px : 22px);
        height: parent.height;
        text: root.text;
        color: root.tone == "error" ? Theme.danger : root.tone == "warn" ? Theme.warning : root.tone == "ok" ? Theme.success : Theme.secondary;
        font-size: root.boxed ? 13px : 11px;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

// Platform labels use existing provider data; no profile-image lookup is added.
export component PlatformBadge inherits Rectangle {
    in property <string> platform;
    width: 54px;
    height: 32px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 6px;
    background: Theme.raised;
    Text {
        width: parent.width;
        height: parent.height;
        text: root.platform;
        color: root.platform == "KICK" ? #a8ec66 : root.platform == "CHZZK" ? Theme.accent : #88baff;
        font-size: 10px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
