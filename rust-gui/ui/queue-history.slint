import { Theme, ActionButton as Button, StatusPill, PlatformBadge } from "design-system.slint";
import { LineEdit, ScrollView } from "std-widgets.slint";

export struct QueueDisplayRow {
    id: string,
    platform: string,
    title: string,
    streamer: string,
    url: string,
    state: string,
    state-label: string,
    state-tone: string,
    attempts: string,
    message: string,
    percent: float,
    percent-label: string,
    part-progress: string,
    output-directory: string,
    output-file: string,
    created-at: string,
    started-at: string,
    finished-at: string,
    can-cancel: bool,
    can-retry: bool,
    can-remove: bool,
}

export struct HistoryDisplayRow {
    kind: string,
    platform: string,
    title: string,
    subject: string,
    state: string,
    state-tone: string,
    detail: string,
    timing: string,
    file: string,
    meta: string,
}

export struct HistoryCalendarDay {
    day: string,
    date: string,
    in-month: bool,
    selected: bool,
}

export global QueueHistoryState {
    in-out property <[QueueDisplayRow]> queue-rows;
    in-out property <bool> queue-busy: true;
    in-out property <bool> queue-loaded: false;
    in-out property <string> queue-message: "VOD 대기열을 불러오는 중...";
    in-out property <string> queue-active-count: "0";
    in-out property <string> queue-queued-count: "0";
    in-out property <string> queue-completed-count: "0";
    in-out property <string> queue-failed-count: "0";
    callback queue-refresh();
    callback queue-action(string, string);
    callback enqueue-current();

    in-out property <[HistoryDisplayRow]> history-rows;
    in-out property <bool> history-busy: true;
    in-out property <bool> history-loaded: false;
    in-out property <string> history-message: "기록을 불러오는 중...";
    in-out property <string> history-view: "ALL";
    in-out property <string> history-search: "";
    in-out property <string> history-status: "";
    in-out property <string> history-from-date: "";
    in-out property <string> history-to-date: "";
    in-out property <string> history-limit: "100";
    in-out property <string> history-calendar-target: "from";
    in-out property <string> history-calendar-label: "";
    in-out property <int> history-calendar-year: 0;
    in-out property <int> history-calendar-month: 0;
    in-out property <[HistoryCalendarDay]> history-calendar-days;
    callback history-refresh();
    callback history-calendar-open(string);
    callback history-calendar-shift(int);
    callback history-calendar-select(string);
    callback history-calendar-clear();
}

component QueueTask inherits Rectangle {
    in property <QueueDisplayRow> task;
    private property <bool> expanded: false;
    min-height: max(116px, task-content.min-height); vertical-stretch: 0;
    background: Theme.surface; border-radius: 8px;
    border-width: 1px; border-color: Theme.border;
    task-content := VerticalLayout {
        padding: 12px; spacing: 6px;
        HorizontalLayout {
            min-height: 32px; vertical-stretch: 0; spacing: 10px;
            PlatformBadge { platform: root.task.platform; }
            VerticalLayout {
                horizontal-stretch: 1; spacing: 3px;
                Text { text: root.task.title; color: Theme.text; font-size: 14px; font-weight: 600; wrap: word-wrap; vertical-stretch: 0; }
                if root.task.streamer != "": Text { text: root.task.streamer; color: Theme.muted; font-size: 11px; vertical-stretch: 0; }
            }
            StatusPill { text: root.task.state-label; tone: root.task.state-tone; }
        }
        Rectangle {
            height: 5px; vertical-stretch: 0; border-radius: 3px; background: Theme.raised;
            Rectangle { x: 0px; y: 0px; height: parent.height; width: parent.width * clamp(root.task.percent, 0, 100) / 100; border-radius: 3px; background: Theme.accent; }
        }
        HorizontalLayout {
            min-height: 30px; vertical-stretch: 0; spacing: 7px;
            Text { text: root.task.percent-label + " · " + root.task.part-progress + " · 시도 " + root.task.attempts; color: Theme.muted; font-size: 11px; horizontal-stretch: 1; vertical-alignment: center; wrap: word-wrap; }
            Button { text: root.expanded ? "상세 닫기" : "상세"; selected: root.expanded; clicked => { root.expanded = !root.expanded; } }
            if root.task.can-cancel: Button { text: "취소"; enabled: !QueueHistoryState.queue-busy; clicked => { QueueHistoryState.queue-action(root.task.id, "cancel"); } }
            if root.task.can-retry: Button { text: "재시도"; enabled: !QueueHistoryState.queue-busy; clicked => { QueueHistoryState.queue-action(root.task.id, "retry"); } }
            if root.task.can-remove: Button { text: "삭제"; enabled: !QueueHistoryState.queue-busy; clicked => { QueueHistoryState.queue-action(root.task.id, "remove"); } }
        }
        // Failures remain visible without requiring the user to expand details.
        if root.task.message != "": Text { text: root.task.message; color: root.task.state-tone == "error" ? Theme.danger : Theme.secondary; font-size: 11px; wrap: word-wrap; vertical-stretch: 0; }
        if root.expanded: VerticalLayout {
            spacing: 4px;
            Text { text: root.task.url; color: Theme.muted; font-size: 11px; wrap: word-wrap; vertical-stretch: 0; }
            Text { text: "저장 폴더: " + root.task.output-directory; color: Theme.muted; font-size: 11px; wrap: word-wrap; vertical-stretch: 0; }
            if root.task.output-file != "": Text { text: "출력: " + root.task.output-file; color: Theme.secondary; font-size: 11px; wrap: word-wrap; vertical-stretch: 0; }
            Text { text: "생성: " + root.task.created-at + " · 시작: " + root.task.started-at + " · 완료: " + root.task.finished-at; color: Theme.muted; font-size: 11px; wrap: word-wrap; vertical-stretch: 0; }
        }
    }
}

export component QueuePage inherits VerticalLayout {
    spacing: 9px;
    HorizontalLayout {
        min-height: 34px; vertical-stretch: 0; spacing: 8px;
        Text { text: "진행 중 " + QueueHistoryState.queue-active-count + "   ·   대기 " + QueueHistoryState.queue-queued-count + "   ·   완료 " + QueueHistoryState.queue-completed-count + "   ·   실패 / 중단 " + QueueHistoryState.queue-failed-count; color: Theme.secondary; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; wrap: word-wrap; }
        Button { text: "새로고침"; enabled: QueueHistoryState.queue-loaded && !QueueHistoryState.queue-busy; clicked => { QueueHistoryState.queue-refresh(); } }
    }
    Text { text: QueueHistoryState.queue-message; color: Theme.muted; font-size: 11px; wrap: word-wrap; vertical-stretch: 0; }
    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            padding: 2px; spacing: 7px; alignment: start;
            if QueueHistoryState.queue-rows.length == 0: Text { text: "대기열이 비어 있습니다. VOD를 분석한 뒤 대기열에 추가하세요."; color: Theme.muted; wrap: word-wrap; }
            for row in QueueHistoryState.queue-rows: QueueTask { task: row; }
        }
    }
}

export component HistoryPage inherits VerticalLayout {
    spacing: 9px;

    HorizontalLayout {
        height: 36px;
        vertical-stretch: 0;
        spacing: 7px;
        Text {
            text: "기록 유형";
            color: Theme.text;
            font-size: 18px;
            font-weight: 700;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
        Button {
            width: 60px;
            height: 32px;
            text: "전체";
            selected: QueueHistoryState.history-view == "ALL";
            enabled: !QueueHistoryState.history-busy;
            clicked => { QueueHistoryState.history-view = "ALL"; QueueHistoryState.history-refresh(); }
        }
        Button {
            width: 60px;
            height: 32px;
            text: "LIVE";
            selected: QueueHistoryState.history-view == "LIVE";
            enabled: !QueueHistoryState.history-busy;
            clicked => { QueueHistoryState.history-view = "LIVE"; QueueHistoryState.history-refresh(); }
        }
        Button {
            width: 60px;
            height: 32px;
            text: "VOD";
            selected: QueueHistoryState.history-view == "VOD";
            enabled: !QueueHistoryState.history-busy;
            clicked => { QueueHistoryState.history-view = "VOD"; QueueHistoryState.history-refresh(); }
        }
        Button {
            width: 72px;
            height: 32px;
            text: "새로고침";
            enabled: QueueHistoryState.history-loaded && !QueueHistoryState.history-busy;
            clicked => { QueueHistoryState.history-refresh(); }
        }
    }

    calendar-popup := PopupWindow {
        x: 250px;
        y: 104px;
        width: 324px;
        height: 324px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Theme.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.secondary;

            VerticalLayout {
                padding: 10px;
                spacing: 6px;

                HorizontalLayout {
                    height: 32px;
                    vertical-stretch: 0;
                    spacing: 6px;
                    Button {
                        width: 34px;
                        height: 30px;
                        text: "<";
                        clicked => { QueueHistoryState.history-calendar-shift(-1); }
                    }
                    Text {
                        text: (QueueHistoryState.history-calendar-target == "from" ? "시작일 · " : "종료일 · ")
                        + QueueHistoryState.history-calendar-label;
                        color: Theme.text;
                        font-size: 13px;
                        font-weight: 700;
                        horizontal-stretch: 1;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    Button {
                        width: 34px;
                        height: 30px;
                        text: ">";
                        clicked => { QueueHistoryState.history-calendar-shift(1); }
                    }
                }

                GridLayout {
                    height: 224px;
                    vertical-stretch: 0;
                    spacing-horizontal: 3px;
                    spacing-vertical: 3px;

                    Text { row: 0; col: 0; text: "일"; color: Theme.muted; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                    Text { row: 0; col: 1; text: "월"; color: Theme.muted; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                    Text { row: 0; col: 2; text: "화"; color: Theme.muted; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                    Text { row: 0; col: 3; text: "수"; color: Theme.muted; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                    Text { row: 0; col: 4; text: "목"; color: Theme.muted; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                    Text { row: 0; col: 5; text: "금"; color: Theme.muted; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                    Text { row: 0; col: 6; text: "토"; color: Theme.muted; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }

                    for day[index] in QueueHistoryState.history-calendar-days: Button {
                        row: index / 7 + 1;
                        col: Math.mod(index, 7);
                        height: 28px;
                        text: day.day; selected: day.selected;
                        opacity: day.in-month ? 1 : 0.55;
                        clicked => {
                            QueueHistoryState.history-calendar-select(day.date);
                            calendar-popup.close();
                        }
                    }
                }

                HorizontalLayout {
                    height: 30px;
                    vertical-stretch: 0;
                    spacing: 6px;
                    Button {
                        height: 28px;
                        text: "초기화";
                        clicked => {
                            QueueHistoryState.history-calendar-clear();
                            calendar-popup.close();
                        }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Button {
                        height: 28px;
                        text: "닫기";
                        clicked => { calendar-popup.close(); }
                    }
                }
            }
        }
    }

    Rectangle {
        min-height: max(116px, content-1.min-height);
        vertical-stretch: 0;
        background: Theme.surface;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.border;
        content-1 := VerticalLayout {
            padding: 10px;
            spacing: 7px;
            HorizontalLayout {
                height: 34px;
                vertical-stretch: 0;
                spacing: 7px;
                LineEdit {
                    height: 34px;
                    horizontal-stretch: 2;
                    text <=> QueueHistoryState.history-search;
                    placeholder-text: "제목, 채널, URL, 파일, 메시지 검색...";
                    enabled: !QueueHistoryState.history-busy;
                    accepted => { QueueHistoryState.history-refresh(); }
                }
                LineEdit {
                    height: 34px;
                    horizontal-stretch: 1;
                    text <=> QueueHistoryState.history-status;
                    placeholder-text: "상태 일부 입력: 완료 / STOP / 병합 / 진행...";
                    enabled: !QueueHistoryState.history-busy;
                    accepted => { QueueHistoryState.history-refresh(); }
                }
            }
            HorizontalLayout {
                height: 34px;
                vertical-stretch: 0;
                spacing: 7px;
                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    LineEdit {
                        height: 34px;
                        horizontal-stretch: 1;
                        text <=> QueueHistoryState.history-from-date;
                        placeholder-text: "시작일 YYYY-MM-DD";
                        enabled: !QueueHistoryState.history-busy;
                        accepted => { QueueHistoryState.history-refresh(); }
                    }
                    Button {
                        width: 52px;
                        height: 32px;
                        horizontal-stretch: 0;
                        text: "달력";
                        enabled: !QueueHistoryState.history-busy;
                        clicked => {
                            QueueHistoryState.history-calendar-open("from");
                            calendar-popup.show();
                        }
                    }
                }
                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    LineEdit {
                        height: 34px;
                        horizontal-stretch: 1;
                        text <=> QueueHistoryState.history-to-date;
                        placeholder-text: "종료일 YYYY-MM-DD";
                        enabled: !QueueHistoryState.history-busy;
                        accepted => { QueueHistoryState.history-refresh(); }
                    }
                    Button {
                        width: 52px;
                        height: 32px;
                        horizontal-stretch: 0;
                        text: "달력";
                        enabled: !QueueHistoryState.history-busy;
                        clicked => {
                            QueueHistoryState.history-calendar-open("to");
                            calendar-popup.show();
                        }
                    }
                }
                LineEdit {
                    width: 110px;
                    height: 34px;
                    horizontal-stretch: 0;
                    text <=> QueueHistoryState.history-limit;
                    placeholder-text: "최대 건수";
                    enabled: !QueueHistoryState.history-busy;
                    accepted => { QueueHistoryState.history-refresh(); }
                }
                Button { height: 32px; text: "필터 적용"; enabled: !QueueHistoryState.history-busy; clicked => { QueueHistoryState.history-refresh(); } }
            }
            Text { text: QueueHistoryState.history-message; color: Theme.secondary; font-size: 11px; wrap: word-wrap; }
        }
    }

    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            padding: 2px;
            spacing: 9px;
            alignment: start;

            if QueueHistoryState.history-rows.length == 0: Rectangle {
                height: 82px;
                vertical-stretch: 0;
                background: Theme.surface;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;
                VerticalLayout {
                    padding: 15px;
                    spacing: 4px;
                    Text { text: "현재 필터 조건에 맞는 기록이 없습니다."; color: Theme.text; font-size: 14px; font-weight: 700; }
                    Text { text: "검색어, 상태와 조회 기간을 확인하세요."; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                }
            }

            for row in QueueHistoryState.history-rows: Rectangle {
                min-height: max(96px, content-2.min-height);
                vertical-stretch: 0;
                background: Theme.surface;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;
                content-2 := VerticalLayout {
                    padding: 8px;
                    spacing: 2px;
                    HorizontalLayout {
                        min-height: 21px;
                        vertical-stretch: 0;
                        spacing: 8px;
                        Text {
                            text: row.kind + " · " + row.platform + " · " + row.title;
                            color: Theme.text;
                            font-size: 13px;
                            font-weight: 700;
                            horizontal-stretch: 1;
                            vertical-stretch: 0;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                        StatusPill { text: row.state; tone: row.state-tone; }
                    }
                    Text { vertical-stretch: 0; text: row.subject; color: Theme.secondary; font-size: 11px; wrap: word-wrap; }
                    if row.detail != "": Text { vertical-stretch: 0; text: row.detail; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                    Text { vertical-stretch: 0; text: row.timing; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                    if row.file != "": Text { vertical-stretch: 0; text: "파일: " + row.file; color: Theme.secondary; font-size: 11px; wrap: word-wrap; }
                    if row.meta != "": Text { vertical-stretch: 0; text: row.meta; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                }
            }
        }
    }
}
