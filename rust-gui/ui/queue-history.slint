import { Button, LineEdit, ScrollView } from "std-widgets.slint";

export struct QueueDisplayRow {
    id: string,
    platform: string,
    title: string,
    streamer: string,
    url: string,
    state: string,
    state-label: string,
    state-tone: string,
    attempts: string,
    message: string,
    percent: float,
    percent-label: string,
    part-progress: string,
    output-directory: string,
    output-file: string,
    created-at: string,
    started-at: string,
    finished-at: string,
    can-cancel: bool,
    can-retry: bool,
    can-remove: bool,
}

export struct HistoryDisplayRow {
    kind: string,
    platform: string,
    title: string,
    subject: string,
    state: string,
    state-tone: string,
    detail: string,
    timing: string,
    file: string,
    meta: string,
}

export struct HistoryCalendarDay {
    day: string,
    date: string,
    in-month: bool,
    selected: bool,
}

export global QueueHistoryState {
    in-out property <[QueueDisplayRow]> queue-rows;
    in-out property <bool> queue-busy: true;
    in-out property <bool> queue-loaded: false;
    in-out property <string> queue-message: "Loading VOD queue...";
    in-out property <string> queue-active-count: "0";
    in-out property <string> queue-queued-count: "0";
    in-out property <string> queue-completed-count: "0";
    in-out property <string> queue-failed-count: "0";
    callback queue-refresh();
    callback queue-action(string, string);
    callback enqueue-current();

    in-out property <[HistoryDisplayRow]> history-rows;
    in-out property <bool> history-busy: true;
    in-out property <bool> history-loaded: false;
    in-out property <string> history-message: "Loading history...";
    in-out property <string> history-view: "ALL";
    in-out property <string> history-search: "";
    in-out property <string> history-status: "";
    in-out property <string> history-from-date: "";
    in-out property <string> history-to-date: "";
    in-out property <string> history-limit: "100";
    in-out property <string> history-calendar-target: "from";
    in-out property <string> history-calendar-label: "";
    in-out property <int> history-calendar-year: 0;
    in-out property <int> history-calendar-month: 0;
    in-out property <[HistoryCalendarDay]> history-calendar-days;
    callback history-refresh();
    callback history-calendar-open(string);
    callback history-calendar-shift(int);
    callback history-calendar-select(string);
    callback history-calendar-clear();
}

component MetricCard inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: 62px;
    vertical-stretch: 0;
    horizontal-stretch: 1;
    background: #ffffff;
    border-radius: 9px;
    border-width: 1px;
    border-color: #e2e8f0;
    VerticalLayout {
        padding: 10px;
        spacing: 2px;
        Text { text: root.label; color: #64748b; font-size: 10px; }
        Text { text: root.value; color: #0f172a; font-size: 19px; font-weight: 700; }
    }
}

export component QueuePage inherits VerticalLayout {
    spacing: 9px;

    HorizontalLayout {
        height: 36px;
        vertical-stretch: 0;
        spacing: 8px;
        Text {
            text: "VOD download queue";
            color: #0f172a;
            font-size: 18px;
            font-weight: 700;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
        Button {
            height: 34px;
            text: "Refresh";
            enabled: QueueHistoryState.queue-loaded && !QueueHistoryState.queue-busy;
            clicked => { QueueHistoryState.queue-refresh(); }
        }
    }

    Text { text: QueueHistoryState.queue-message; color: #334155; wrap: word-wrap; font-size: 12px; }

    HorizontalLayout {
        height: 62px;
        vertical-stretch: 0;
        spacing: 8px;
        MetricCard { label: "Active"; value: QueueHistoryState.queue-active-count; }
        MetricCard { label: "Queued"; value: QueueHistoryState.queue-queued-count; }
        MetricCard { label: "Completed"; value: QueueHistoryState.queue-completed-count; }
        MetricCard { label: "Failed / Interrupted"; value: QueueHistoryState.queue-failed-count; }
    }

    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            padding: 2px;
            spacing: 9px;

            if QueueHistoryState.queue-rows.length == 0: Rectangle {
                height: 82px;
                vertical-stretch: 0;
                background: #ffffff;
                border-radius: 10px;
                border-width: 1px;
                border-color: #e2e8f0;
                VerticalLayout {
                    padding: 15px;
                    spacing: 4px;
                    Text { text: "Queue is empty."; color: #0f172a; font-size: 14px; font-weight: 700; }
                    Text { text: "Analyze a VOD and use Add to Queue to create a persisted job."; color: #64748b; font-size: 11px; wrap: word-wrap; }
                }
            }

            for row in QueueHistoryState.queue-rows: Rectangle {
                min-height: 174px;
                vertical-stretch: 0;
                background: #ffffff;
                border-radius: 10px;
                border-width: 1px;
                border-color: row.state-tone == "error" ? #fecaca : row.state-tone == "warn" ? #fde68a : row.state-tone == "ok" ? #bbf7d0 : #e2e8f0;
                VerticalLayout {
                    padding: 12px;
                    spacing: 5px;
                    HorizontalLayout {
                        height: 24px;
                        vertical-stretch: 0;
                        spacing: 8px;
                        Text {
                            text: row.platform + " · " + row.title;
                            color: #0f172a;
                            font-size: 15px;
                            font-weight: 700;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Text {
                            text: row.state-label;
                            color: row.state-tone == "error" ? #b91c1c : row.state-tone == "warn" ? #a16207 : row.state-tone == "ok" ? #15803d : #64748b;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                    if row.streamer != "": Text { text: row.streamer; color: #64748b; font-size: 11px; }
                    Text { text: row.url; color: #475569; font-size: 11px; wrap: word-wrap; }
                    Rectangle {
                        height: 8px;
                        vertical-stretch: 0;
                        background: #e2e8f0;
                        border-radius: 4px;
                        Rectangle {
                            x: 0px;
                            y: 0px;
                            height: parent.height;
                            width: parent.width * row.percent / 100;
                            background: #334155;
                            border-radius: 4px;
                        }
                    }
                    Text {
                        text: row.percent-label + "  ·  " + row.part-progress + "  ·  Attempt " + row.attempts;
                        color: #64748b;
                        font-size: 11px;
                    }
                    if row.message != "": Text { text: row.message; color: #475569; font-size: 11px; wrap: word-wrap; }
                    if row.output-file != "": Text { text: "Output: " + row.output-file; color: #475569; font-size: 11px; wrap: word-wrap; }
                    Text {
                        text: "Created: " + row.created-at + "  ·  Started: " + row.started-at + "  ·  Finished: " + row.finished-at;
                        color: #94a3b8;
                        font-size: 10px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        height: 32px;
                        vertical-stretch: 0;
                        spacing: 7px;
                        if row.can-cancel: Button {
                            height: 30px;
                            text: "Cancel";
                            enabled: !QueueHistoryState.queue-busy;
                            clicked => { QueueHistoryState.queue-action(row.id, "cancel"); }
                        }
                        if row.can-retry: Button {
                            height: 30px;
                            text: "Retry";
                            enabled: !QueueHistoryState.queue-busy;
                            clicked => { QueueHistoryState.queue-action(row.id, "retry"); }
                        }
                        if row.can-remove: Button {
                            height: 30px;
                            text: "Remove";
                            enabled: !QueueHistoryState.queue-busy;
                            clicked => { QueueHistoryState.queue-action(row.id, "remove"); }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }
                }
            }
        }
    }
}

export component HistoryPage inherits VerticalLayout {
    spacing: 9px;

    HorizontalLayout {
        height: 36px;
        vertical-stretch: 0;
        spacing: 7px;
        Text {
            text: "LIVE / VOD history";
            color: #0f172a;
            font-size: 18px;
            font-weight: 700;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
        Button { height: 32px; text: QueueHistoryState.history-view == "ALL" ? "✓ All" : "All"; enabled: !QueueHistoryState.history-busy; clicked => { QueueHistoryState.history-view = "ALL"; QueueHistoryState.history-refresh(); } }
        Button { height: 32px; text: QueueHistoryState.history-view == "LIVE" ? "✓ LIVE" : "LIVE"; enabled: !QueueHistoryState.history-busy; clicked => { QueueHistoryState.history-view = "LIVE"; QueueHistoryState.history-refresh(); } }
        Button { height: 32px; text: QueueHistoryState.history-view == "VOD" ? "✓ VOD" : "VOD"; enabled: !QueueHistoryState.history-busy; clicked => { QueueHistoryState.history-view = "VOD"; QueueHistoryState.history-refresh(); } }
        Button { height: 32px; text: "Refresh"; enabled: QueueHistoryState.history-loaded && !QueueHistoryState.history-busy; clicked => { QueueHistoryState.history-refresh(); } }
    }

    calendar-popup := PopupWindow {
        x: 250px;
        y: 104px;
        width: 324px;
        height: 304px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: #ffffff;
            border-radius: 10px;
            border-width: 1px;
            border-color: #cbd5e1;

            VerticalLayout {
                padding: 10px;
                spacing: 6px;

                HorizontalLayout {
                    height: 32px;
                    vertical-stretch: 0;
                    spacing: 6px;
                    Button {
                        width: 34px;
                        height: 30px;
                        text: "<";
                        clicked => { QueueHistoryState.history-calendar-shift(-1); }
                    }
                    Text {
                        text: (QueueHistoryState.history-calendar-target == "from" ? "From · " : "To · ")
                            + QueueHistoryState.history-calendar-label;
                        color: #0f172a;
                        font-size: 13px;
                        font-weight: 700;
                        horizontal-stretch: 1;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    Button {
                        width: 34px;
                        height: 30px;
                        text: ">";
                        clicked => { QueueHistoryState.history-calendar-shift(1); }
                    }
                }

                GridLayout {
                    height: 224px;
                    vertical-stretch: 0;
                    spacing-horizontal: 3px;
                    spacing-vertical: 3px;

                    Text { row: 0; col: 0; text: "Sun"; color: #64748b; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                    Text { row: 0; col: 1; text: "Mon"; color: #64748b; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                    Text { row: 0; col: 2; text: "Tue"; color: #64748b; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                    Text { row: 0; col: 3; text: "Wed"; color: #64748b; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                    Text { row: 0; col: 4; text: "Thu"; color: #64748b; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                    Text { row: 0; col: 5; text: "Fri"; color: #64748b; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                    Text { row: 0; col: 6; text: "Sat"; color: #64748b; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }

                    for day[index] in QueueHistoryState.history-calendar-days: Button {
                        row: index / 7 + 1;
                        col: index % 7;
                        height: 28px;
                        text: day.selected ? "✓ " + day.day : day.day;
                        opacity: day.in-month ? 1 : 0.55;
                        clicked => {
                            QueueHistoryState.history-calendar-select(day.date);
                            calendar-popup.close();
                        }
                    }
                }

                HorizontalLayout {
                    height: 30px;
                    vertical-stretch: 0;
                    spacing: 6px;
                    Button {
                        height: 28px;
                        text: "Clear";
                        clicked => {
                            QueueHistoryState.history-calendar-clear();
                            calendar-popup.close();
                        }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Button {
                        height: 28px;
                        text: "Close";
                        clicked => { calendar-popup.close(); }
                    }
                }
            }
        }
    }

    Rectangle {
        min-height: 116px;
        vertical-stretch: 0;
        background: #ffffff;
        border-radius: 9px;
        border-width: 1px;
        border-color: #e2e8f0;
        VerticalLayout {
            padding: 10px;
            spacing: 7px;
            HorizontalLayout {
                height: 34px;
                vertical-stretch: 0;
                spacing: 7px;
                LineEdit {
                    height: 34px;
                    horizontal-stretch: 2;
                    text <=> QueueHistoryState.history-search;
                    placeholder-text: "Search title, channel, URL, file, message...";
                    enabled: !QueueHistoryState.history-busy;
                    accepted => { QueueHistoryState.history-refresh(); }
                }
                LineEdit {
                    height: 34px;
                    horizontal-stretch: 1;
                    text <=> QueueHistoryState.history-status;
                    placeholder-text: "Status (optional)";
                    enabled: !QueueHistoryState.history-busy;
                    accepted => { QueueHistoryState.history-refresh(); }
                }
            }
            HorizontalLayout {
                height: 34px;
                vertical-stretch: 0;
                spacing: 7px;
                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    LineEdit {
                        height: 34px;
                        horizontal-stretch: 1;
                        text <=> QueueHistoryState.history-from-date;
                        placeholder-text: "From YYYY-MM-DD";
                        enabled: !QueueHistoryState.history-busy;
                        accepted => { QueueHistoryState.history-refresh(); }
                    }
                    Button {
                        width: 52px;
                        height: 32px;
                        horizontal-stretch: 0;
                        text: "Date";
                        enabled: !QueueHistoryState.history-busy;
                        clicked => {
                            QueueHistoryState.history-calendar-open("from");
                            calendar-popup.show();
                        }
                    }
                }
                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    LineEdit {
                        height: 34px;
                        horizontal-stretch: 1;
                        text <=> QueueHistoryState.history-to-date;
                        placeholder-text: "To YYYY-MM-DD";
                        enabled: !QueueHistoryState.history-busy;
                        accepted => { QueueHistoryState.history-refresh(); }
                    }
                    Button {
                        width: 52px;
                        height: 32px;
                        horizontal-stretch: 0;
                        text: "Date";
                        enabled: !QueueHistoryState.history-busy;
                        clicked => {
                            QueueHistoryState.history-calendar-open("to");
                            calendar-popup.show();
                        }
                    }
                }
                LineEdit {
                    width: 110px;
                    height: 34px;
                    horizontal-stretch: 0;
                    text <=> QueueHistoryState.history-limit;
                    placeholder-text: "Limit";
                    enabled: !QueueHistoryState.history-busy;
                    accepted => { QueueHistoryState.history-refresh(); }
                }
                Button { height: 32px; text: "Apply filters"; enabled: !QueueHistoryState.history-busy; clicked => { QueueHistoryState.history-refresh(); } }
            }
            Text { text: QueueHistoryState.history-message; color: #475569; font-size: 11px; wrap: word-wrap; }
        }
    }

    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            padding: 2px;
            spacing: 9px;

            if QueueHistoryState.history-rows.length == 0: Rectangle {
                height: 82px;
                vertical-stretch: 0;
                background: #ffffff;
                border-radius: 10px;
                border-width: 1px;
                border-color: #e2e8f0;
                VerticalLayout {
                    padding: 15px;
                    spacing: 4px;
                    Text { text: "No history matches the current filters."; color: #0f172a; font-size: 14px; font-weight: 700; }
                    Text { text: "History comes from the canonical live_recordings and vod_jobs tables."; color: #64748b; font-size: 11px; wrap: word-wrap; }
                }
            }

            for row in QueueHistoryState.history-rows: Rectangle {
                min-height: 128px;
                vertical-stretch: 0;
                background: #ffffff;
                border-radius: 10px;
                border-width: 1px;
                border-color: row.state-tone == "error" ? #fecaca : row.state-tone == "warn" ? #fde68a : row.state-tone == "ok" ? #bbf7d0 : #e2e8f0;
                VerticalLayout {
                    padding: 12px;
                    spacing: 4px;
                    HorizontalLayout {
                        height: 23px;
                        vertical-stretch: 0;
                        spacing: 8px;
                        Text {
                            text: row.kind + " · " + row.platform + " · " + row.title;
                            color: #0f172a;
                            font-size: 14px;
                            font-weight: 700;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Text {
                            text: row.state;
                            color: row.state-tone == "error" ? #b91c1c : row.state-tone == "warn" ? #a16207 : row.state-tone == "ok" ? #15803d : #64748b;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                    Text { text: row.subject; color: #475569; font-size: 11px; wrap: word-wrap; }
                    if row.detail != "": Text { text: row.detail; color: #64748b; font-size: 11px; wrap: word-wrap; }
                    Text { text: row.timing; color: #94a3b8; font-size: 10px; wrap: word-wrap; }
                    if row.file != "": Text { text: "File: " + row.file; color: #475569; font-size: 10px; wrap: word-wrap; }
                    if row.meta != "": Text { text: row.meta; color: #94a3b8; font-size: 10px; }
                }
            }
        }
    }
}
